    "NSAppleMusicUsageDescription" : {
      "comment" : "Why the app requests Apple Music catalog access",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, um Metadaten und Cover lokaler Titel zu ergänzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to supplement local song metadata and artwork."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para completar los metadatos y las portadas de las canciones locales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet de compléter les métadonnées et les pochettes des morceaux locaux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルの曲のメタデータとアートワークを補完するために使用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于补充本地音频的歌曲元数据和封面。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, um eine Verbindung zu deinem konfigurierten NAS, DS Audio und anderen Medienquellen im lokalen Netzwerk herzustellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to connect to your configured NAS, DS Audio, and other local network media sources."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para conectar con tu NAS, DS Audio y otras fuentes multimedia configuradas en la red local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet de se connecter à votre NAS, à DS Audio et aux autres sources multimédias configurées sur le réseau local."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定したNAS、DS Audio、およびその他のローカルネットワークのメディアソースに接続するために使用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于连接你配置的 NAS、DS Audio 和其他局域网在线媒体源。"
          }
        }
      }
    }
  },
  "version" : "1.0"
