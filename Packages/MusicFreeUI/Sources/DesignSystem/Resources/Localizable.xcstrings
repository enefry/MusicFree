    "打开播放页歌词时按需在线获取，成功后保存到本地资料库。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liedtexte werden beim Öffnen der Liedtextseite des Players bei Bedarf von LRCLIB abgerufen. Erfolgreiche Ergebnisse werden in der lokalen Mediathek gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fetch lyrics on demand from LRCLIB when the player lyrics page opens. Successful results are saved to the local library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtén letras bajo demanda desde LRCLIB al abrir la página de letras del reproductor. Los resultados obtenidos se guardan en la biblioteca local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Récupère les paroles à la demande depuis LRCLIB à l’ouverture de la page des paroles du lecteur. Les résultats obtenus sont enregistrés dans la bibliothèque locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレーヤーの歌詞ページを開いたときに、LRCLIBから必要に応じて歌詞を取得します。取得に成功した歌詞はローカルライブラリに保存されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开播放页歌词时按需在线获取，成功后保存到本地资料库。"
          }
        }
      }
    },
