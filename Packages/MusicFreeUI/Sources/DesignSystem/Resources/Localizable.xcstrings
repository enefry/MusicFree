          }
        }
      }
    },
    "仅在左右声道差异明显时调整，强度不会超过设置值。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjusts only when the left and right channels differ significantly, up to the selected strength."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在左右声道差异明显时调整，强度不会超过设置值。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste uniquement les écarts importants entre les canaux, sans dépasser l’intensité choisie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleicht nur deutliche Unterschiede zwischen den Kanälen aus, höchstens bis zur gewählten Stärke."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta solo cuando hay diferencias importantes entre canales, sin superar la intensidad elegida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右チャンネルの差が大きい場合のみ、設定した強度を上限として調整します。"
          }
        }
      }
    },
    "持续混合左右声道，数值越大，声场越集中。100% 为单声道。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuously blends the channels. Higher values narrow the soundstage. 100% is mono."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "持续混合左右声道，数值越大，声场越集中。100% 为单声道。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mélange les canaux en continu. Une valeur élevée resserre la scène sonore. 100% correspond au mono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mischt die Kanäle kontinuierlich. Höhere Werte verengen das Klangbild. 100% entspricht Mono."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezcla los canales continuamente. Los valores altos estrechan la escena sonora. 100% es mono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右チャンネルを常に混合します。値が大きいほど音場が狭くなります。100% はモノラルです。"
          }
        }
      }
    },
    "0% 保留原声；100% 允许最大调整到单声道，并非始终输出单声道。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0% preserves the original channels. 100% allows adjustment up to mono; it does not always produce mono."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0% 保留原声；100% 允许最大调整到单声道，并非始终输出单声道。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "0% préserve les canaux d’origine. 100% autorise un ajustement jusqu’au mono, sans imposer une sortie mono constante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "0% erhält die ursprünglichen Kanäle. 100% erlaubt eine Anpassung bis Mono, erzwingt aber keine ständige Monoausgabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "0% conserva los canales originales. 100% permite ajustar hasta mono, sin producir siempre una salida mono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0% は元の音を維持します。100% は最大でモノラルまでの調整を許可しますが、常にモノラルになるわけではありません。"
          }
        }
      }
    },
    "0% 保留原声，100% 为单声道。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0% preserves the original channels. 100% is mono."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0% 保留原声，100% 为单声道。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "0% préserve les canaux d’origine ; 100% correspond au mono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "0% erhält die ursprünglichen Kanäle, 100% entspricht Mono."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "0% conserva los canales originales; 100% es mono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0% は元の音を維持し、100% はモノラルになります。"
          }
        }
      }
    },
    "播放中修改后，请暂停再继续播放，使新设置生效。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After changing settings during playback, pause and resume to apply them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放中修改后，请暂停再继续播放，使新设置生效。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après une modification pendant la lecture, mettez en pause puis reprenez pour l’appliquer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Änderungen während der Wiedergabe pausieren und fortsetzen, um sie anzuwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras cambiar los ajustes durante la reproducción, pausa y reanuda para aplicarlos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生中に変更した場合は、一時停止してから再開すると反映されます。"
          }
        }
      }
    },
    "参数尚未保存，请重试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parameters have not been saved. Please retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参数尚未保存，请重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paramètres n’ont pas été enregistrés. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Parameter wurden nicht gespeichert. Bitte erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han guardado los parámetros. Inténtalo de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パラメータが保存されていません。再試行してください。"
          }
        }
      }
    },
