    "guide.drive.072": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "C. Data Access"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "C. 数据访问"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C. Accès aux données"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "C. Datenzugriff"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "C. Acceso a datos"
          }
        },
        "ja": {
          "stringUnit": {
