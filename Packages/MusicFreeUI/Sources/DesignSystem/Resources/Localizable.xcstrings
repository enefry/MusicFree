    "guide.drive.046": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open it and tap <b>Enable</b>. When the button changes to Manage, this step is complete."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开并点击<b>启用</b>。按钮变成“管理”即表示完成。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez-la et touchez <b>Activer</b>. L’étape est terminée lorsque le bouton devient Gérer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen und <b>Aktivieren</b> wählen. Sobald die Schaltfläche Verwalten heißt, ist der Schritt abgeschlossen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ábrela y pulsa <b>Habilitar</b>. El paso termina cuando el botón cambia a Administrar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いて<b>有効にする</b>を押します。ボタンが「管理」に変われば完了です。"
          }
        }
      }
    },
