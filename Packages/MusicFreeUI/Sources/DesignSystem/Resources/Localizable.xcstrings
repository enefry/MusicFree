    "guide.drive.147": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<a href=\"https://developers.google.com/identity/oauth2/web/guides/get-google-api-clientid\" target=\"_blank\" rel=\"noreferrer\">Get your Google API client ID</a> — general project and Client ID guidance; its Web client type does not apply here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<a href=\"https://developers.google.com/identity/oauth2/web/guides/get-google-api-clientid\" target=\"_blank\" rel=\"noreferrer\">获取 Google API 客户端 ID</a>——通用项目及 ID 指引，其中的网页客户端类型不适用于本项目。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<a href=\"https://developers.google.com/identity/oauth2/web/guides/get-google-api-clientid\" target=\"_blank\" rel=\"noreferrer\">Obtenir un ID client Google API</a> — conseils généraux ; son type de client Web ne s’applique pas ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<a href=\"https://developers.google.com/identity/oauth2/web/guides/get-google-api-clientid\" target=\"_blank\" rel=\"noreferrer\">Google API-Client-ID erhalten</a> — allgemeine Anleitung; der Web-Clienttyp gilt hier nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<a href=\"https://developers.google.com/identity/oauth2/web/guides/get-google-api-clientid\" target=\"_blank\" rel=\"noreferrer\">Obtener tu ID de cliente de Google API</a> — guía general; su cliente web no se aplica aquí."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<a href=\"https://developers.google.com/identity/oauth2/web/guides/get-google-api-clientid\" target=\"_blank\" rel=\"noreferrer\">Google API クライアント ID の取得</a> — 一般的な手順。記載のウェブクライアントは本プロジェクトには使いません。"
          }
        }
      }
    },
    "guide.drive.148": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<a href=\"https://rclone.org/drive/#making-your-own-client-id\" target=\"_blank\" rel=\"noreferrer\">rclone: Making your own client_id</a> — useful for Drive API, consent, scopes, and test users; its Desktop client step does not apply here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<a href=\"https://rclone.org/drive/#making-your-own-client-id\" target=\"_blank\" rel=\"noreferrer\">rclone：创建自己的 client_id</a>——可参考 Drive API、同意、权限范围与测试用户说明；其中的桌面客户端步骤不适用。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<a href=\"https://rclone.org/drive/#making-your-own-client-id\" target=\"_blank\" rel=\"noreferrer\">rclone : créer son client_id</a> — utile pour l’API Drive, le consentement, les champs et les utilisateurs de test ; l’étape du client de bureau ne s’applique pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<a href=\"https://rclone.org/drive/#making-your-own-client-id\" target=\"_blank\" rel=\"noreferrer\">rclone: eigene client_id erstellen</a> — hilfreich für Drive-API, Zustimmung, Bereiche und Testnutzer; der Desktop-Client-Schritt gilt nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<a href=\"https://rclone.org/drive/#making-your-own-client-id\" target=\"_blank\" rel=\"noreferrer\">rclone: crear tu client_id</a> — útil para API, consentimiento, permisos y usuarios de prueba; el paso de cliente de escritorio no se aplica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<a href=\"https://rclone.org/drive/#making-your-own-client-id\" target=\"_blank\" rel=\"noreferrer\">rclone：独自 client_id の作成</a> — Drive API、同意、スコープ、テストユーザーの参考。デスクトップクライアントの手順は使いません。"
          }
        }
      }
    },
