    },
    "仅用于浏览 Google Drive 音频文件、下载并导入本地媒体库。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird nur zum Durchsuchen von Google-Drive-Audiodateien sowie zum Herunterladen und Importieren in die lokale Mediathek verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used only to browse Google Drive audio files and download and import them into the local media library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa únicamente para explorar archivos de audio de Google Drive y descargarlos e importarlos a la biblioteca local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé uniquement pour parcourir les fichiers audio Google Drive, puis les télécharger et les importer dans la bibliothèque locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Driveの音声ファイルの表示、ダウンロード、ローカルライブラリへの読み込みにのみ使用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅用于浏览 Google Drive 音频文件、下载并导入本地媒体库。"
          }
        }
      }
    },
    "仅用于浏览来源目录、搜索音频、下载并导入本地媒体库，以及临时试听。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird nur zum Durchsuchen von Quellverzeichnissen, zur Audiosuche, zum Herunterladen und Importieren in die lokale Mediathek sowie zur temporären Vorschau verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used only to browse source directories, search audio, download and import it into the local media library, and audition it temporarily."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa únicamente para explorar directorios de fuentes, buscar audio, descargarlo e importarlo a la biblioteca local y escucharlo temporalmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé uniquement pour parcourir les répertoires sources, rechercher des fichiers audio, les télécharger et les importer dans la bibliothèque locale, ainsi que pour une écoute temporaire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソースディレクトリの表示、音声の検索、ローカルライブラリへのダウンロードと読み込み、一時的な試聴にのみ使用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅用于浏览来源目录、搜索音频、下载并导入本地媒体库，以及临时试听。"
          }
        }
      }
    },
