    "guide.drive.133": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "403 access_denied or “app is being tested”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "403 access_denied 或“应用正在测试中”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "403 access_denied ou « application en cours de test »"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "403 access_denied oder „App wird getestet“"
          }
        },
        "es": {
