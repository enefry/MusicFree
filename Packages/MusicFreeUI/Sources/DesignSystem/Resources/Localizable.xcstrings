    "guide.drive.136": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm that the client type is iOS, the Bundle ID is <span class=\"mono\">win.tools4me.music</span>, and the reversed ID belongs to the same Client ID. The callback must be <span class=\"mono\">REVERSED_CLIENT_ID:/oauth2redirect/google</span>."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认客户端类型为 iOS、Bundle ID 为 <span class=\"mono\">win.tools4me.music</span>，反向 ID 属于同一客户端 ID。回调必须为 <span class=\"mono\">REVERSED_CLIENT_ID:/oauth2redirect/google</span>。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le type iOS, l’ID de bundle <span class=\"mono\">win.tools4me.music</span> et que l’ID inversé appartient au même ID client. Le rappel doit être <span class=\"mono\">REVERSED_CLIENT_ID:/oauth2redirect/google</span>."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clienttyp iOS und Bundle-ID <span class=\"mono\">win.tools4me.music</span> prüfen. Die umgekehrte ID muss zur selben Client-ID gehören. Rückleitung: <span class=\"mono\">REVERSED_CLIENT_ID:/oauth2redirect/google</span>."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma el tipo iOS, el ID de paquete <span class=\"mono\">win.tools4me.music</span> y que el ID inverso pertenezca al mismo cliente. El retorno debe ser <span class=\"mono\">REVERSED_CLIENT_ID:/oauth2redirect/google</span>."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "種類が iOS、バンドル ID が <span class=\"mono\">win.tools4me.music</span> で、逆順 ID が同じクライアントに属することを確認します。コールバックは <span class=\"mono\">REVERSED_CLIENT_ID:/oauth2redirect/google</span> です。"
          }
        }
      }
    },
    "guide.drive.137": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "invalid_client"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "invalid_client"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "invalid_client"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "invalid_client"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "invalid_client"
          }
        },
        "ja": {
