    "删除导入流程留下的暂存副本。只处理暂存目录，不影响已经进入资料库的媒体文件。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Deletes staging copies left by the import flow. Only the staging directory is handled; media already in the library is not affected." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除导入流程留下的暂存副本。只处理暂存目录，不影响已经进入资料库的媒体文件。" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Supprime les copies de préparation laissées par l’importation. Seul le dossier de préparation est traité ; les fichiers multimédias déjà présents dans la bibliothèque ne sont pas affectés." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Löscht die vom Importvorgang hinterlassenen Staging-Kopien. Nur das Staging-Verzeichnis wird bearbeitet; Medien in der Mediathek bleiben unberührt." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Elimina las copias de preparación que dejó la importación. Solo se procesa el directorio de preparación; los archivos multimedia que ya están en la biblioteca no se ven afectados." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "読み込み処理で残ったステージングのコピーを削除します。ステージングディレクトリだけを処理し、ライブラリに取り込まれたメディアファイルには影響しません。" } }
      }
    },
    "检查未完成的删除事务，并根据资料库记录恢复或完成事务。不会重新删除资料库中的媒体文件。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Checks unfinished removal transactions and restores or completes them according to library records. It does not delete library media again." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "检查未完成的删除事务，并根据资料库记录恢复或完成事务。不会重新删除资料库中的媒体文件。" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vérifie les transactions de suppression inachevées et les restaure ou les termine selon les enregistrements de la bibliothèque. Les fichiers multimédias de la bibliothèque ne sont pas supprimés à nouveau." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Prüft unvollständige Löschvorgänge und stellt sie anhand der Mediatheksdaten wieder her oder schließt sie ab. Medien in der Mediathek werden nicht erneut gelöscht." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Comprueba las transacciones de eliminación sin terminar y las restaura o completa según los registros de la biblioteca. Los archivos multimedia de la biblioteca no se eliminan de nuevo." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "未完了の削除処理を確認し、ライブラリの記録に基づいて復元または完了します。ライブラリのメディアファイルを再度削除することはありません。" } }
      }
    },
    "删除已经完成处理的隔离副本，保留仍处于 pending 状态的文件。清理后不能从隔离目录恢复这些副本。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Deletes finalized quarantine copies while preserving files that are still pending. After cleanup, those copies cannot be restored from quarantine." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除已经完成处理的隔离副本，保留仍处于 pending 状态的文件。清理后不能从隔离目录恢复这些副本。" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Supprime les copies de quarantaine déjà traitées et conserve les fichiers encore en attente. Après le nettoyage, ces copies ne peuvent pas être restaurées depuis la quarantaine." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Löscht abgeschlossene Quarantänekopien und behält weiterhin ausstehende Dateien. Nach der Bereinigung können diese Kopien nicht aus der Quarantäne wiederhergestellt werden." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Elimina las copias de cuarentena ya procesadas y conserva los archivos que siguen pendientes. Después de la limpieza, esas copias no se pueden restaurar desde la cuarentena." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "処理済みの隔離コピーを削除し、まだ保留中のファイルは残します。消去後、これらのコピーは隔離領域から復元できません。" } }
      }
    },
    "清理完成后，导入暂存占用会减少，存储状态会更新；正在进行的导入会等待维护完成。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "After cleanup, staging usage should decrease and storage status will update; an active import waits for maintenance to finish." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "清理完成后，导入暂存占用会减少，存储状态会更新；正在进行的导入会等待维护完成。" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Après le nettoyage, l’espace de préparation devrait diminuer et l’état du stockage sera mis à jour ; un import en cours attendra la fin de la maintenance." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Nach der Bereinigung sollte der belegte Staging-Speicher sinken und der Speicherstatus aktualisiert werden; ein laufender Import wartet, bis die Wartung abgeschlossen ist." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Después de la limpieza, debería reducirse el espacio de preparación y se actualizará el estado del almacenamiento; una importación en curso esperará a que termine el mantenimiento." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "消去後はステージングの使用量が減り、ストレージの状態が更新されます。進行中の読み込みはメンテナンスの完了を待ちます。" } }
      }
    },
    "待删除项目会逐项核对；可恢复或可完成的事务会被处理，仍无法判断的事务会保留。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Pending removals are checked one by one; recoverable or completable transactions are handled, while unresolved transactions remain." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "待删除项目会逐项核对；可恢复或可完成的事务会被处理，仍无法判断的事务会保留。" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les suppressions en attente sont vérifiées une par une ; les transactions récupérables ou finalisables sont traitées, tandis que celles qui restent indéterminées sont conservées." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Ausstehende Löschungen werden einzeln geprüft; wiederherstellbare oder abschließbare Vorgänge werden bearbeitet, unklare Vorgänge bleiben erhalten." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Las eliminaciones pendientes se comprueban una a una; se procesan las transacciones recuperables o finalizables y se conservan las que siguen sin determinar." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "保留中の削除項目を1件ずつ確認し、復元または完了できる処理を実行します。判断できない処理は残します。" } }
      }
    },
    "清理完成后，隔离文件占用会减少；pending 隔离文件会保留，不会被清理。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "After cleanup, quarantine usage should decrease; pending quarantine files are preserved." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "清理完成后，隔离文件占用会减少；pending 隔离文件会保留，不会被清理。" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Après le nettoyage, l’espace occupé par la quarantaine devrait diminuer ; les fichiers de quarantaine en attente sont conservés." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Nach der Bereinigung sollte der Quarantänespeicher kleiner werden; ausstehende Quarantänedateien bleiben erhalten." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Después de la limpieza, debería reducirse el espacio ocupado por la cuarentena; los archivos de cuarentena pendientes se conservan." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "消去後は隔離ファイルの使用量が減ります。保留中の隔離ファイルは残り、消去されません。" } }
      }
    },
    "将删除导入暂存目录中的文件；已经进入资料库的媒体文件不受影响。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Files in the import staging directory will be deleted; library media is not affected." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将删除导入暂存目录中的文件；已经进入资料库的媒体文件不受影响。" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les fichiers du répertoire de préparation de l’importation seront supprimés ; les fichiers multimédias de la bibliothèque ne sont pas affectés." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Dateien im Import-Staging-Verzeichnis werden gelöscht; Medien in der Mediathek bleiben unberührt." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Se eliminarán los archivos del directorio de preparación de importación; los archivos multimedia de la biblioteca no se verán afectados." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "読み込みステージングディレクトリ内のファイルを削除します。ライブラリのメディアファイルには影響しません。" } }
      }
    },
    "将核对未完成的删除事务，并恢复或完成能够确定状态的事务；无法判断的事务会保留。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Unfinished removal transactions will be checked; transactions with a known state will be restored or completed, and unresolved ones will remain." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将核对未完成的删除事务，并恢复或完成能够确定状态的事务；无法判断的事务会保留。" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les transactions de suppression inachevées seront vérifiées ; celles dont l’état est connu seront restaurées ou finalisées, et les transactions indéterminées seront conservées." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Unvollständige Löschvorgänge werden geprüft; Vorgänge mit bekanntem Status werden wiederhergestellt oder abgeschlossen, unklare Vorgänge bleiben erhalten." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Se comprobarán las transacciones de eliminación sin terminar; las que tengan un estado conocido se restaurarán o completarán y las que no puedan determinarse se conservarán." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "未完了の削除処理を確認し、状態を判定できる処理は復元または完了します。判断できない処理は残します。" } }
      }
    },
    "将删除已完成处理的隔离副本，并保留 pending 隔离文件；清理后的副本不能恢复。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Finalized quarantine copies will be deleted and pending quarantine files will be preserved; cleared copies cannot be restored." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将删除已完成处理的隔离副本，并保留 pending 隔离文件；清理后的副本不能恢复。" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les copies de quarantaine finalisées seront supprimées et les fichiers de quarantaine en attente seront conservés ; les copies supprimées ne pourront pas être restaurées." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Abgeschlossene Quarantänekopien werden gelöscht und ausstehende Quarantänedateien bleiben erhalten; bereinigte Kopien können nicht wiederhergestellt werden." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Se eliminarán las copias de cuarentena finalizadas y se conservarán los archivos de cuarentena pendientes; las copias limpiadas no se podrán restaurar." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "処理済みの隔離コピーを削除し、保留中の隔離ファイルは残します。消去したコピーは復元できません。" } }
      }
    },
