    "音频效果已旁路：处理位置不可用、总线位置已占用，或处理器不符合要求。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio effect bypassed: placement unavailable, output position occupied, or processor requirements not met."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频效果已旁路：处理位置不可用、总线位置已占用，或处理器不符合要求。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effet audio contourné : position indisponible, sortie occupée ou processeur non conforme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audioeffekt umgangen: Position nicht verfügbar, Ausgabeposition belegt oder Prozessoranforderungen nicht erfüllt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Efecto de audio omitido: posición no disponible, salida ocupada o procesador no compatible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理位置が利用不可、出力位置が使用中、またはプロセッサが要件を満たさないため、エフェクトをバイパスしました。"
          }
        }
      }
    },
