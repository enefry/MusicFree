          }
        }
      }
    },
    "guide.drive.110": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebuild and install MusicFree. An older installed build will not contain the new callback URL scheme."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新构建并安装 MusicFree。旧安装版本不会包含新的回调 URL Scheme。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recompilez et installez MusicFree. Une ancienne version installée ne contient pas le nouveau schéma d’URL de rappel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicFree neu erstellen und installieren. Eine ältere Installation enthält das neue Rückleitungs-URL-Schema nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a compilar e instalar MusicFree. Una versión anterior instalada no contendrá el nuevo esquema URL de retorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicFree を再ビルドしてインストールします。旧版には新しいコールバック URL スキームが含まれません。"
          }
        }
      }
    },
    "guide.drive.111": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open <b>Settings → Online Sources → Add Google Drive</b>."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开<b>设置 → 在线源 → 添加 Google Drive</b>。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez <b>Réglages → Sources en ligne → Ajouter Google Drive</b>."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>Einstellungen → Onlinequellen → Google Drive hinzufügen</b> öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre <b>Ajustes → Fuentes en línea → Añadir Google Drive</b>."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>設定 → オンラインソース → Google Drive を追加</b>を開きます。"
          }
        }
      }
    },
    "guide.drive.112": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a source name and paste the same original <b>OAuth Client ID</b>. Do not paste the reversed ID or a client secret."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入来源名称，粘贴同一个原始 <b>OAuth 客户端 ID</b>。不要粘贴反向 ID 或客户端密钥。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un nom de source et collez le même <b>ID client OAuth</b> d’origine, pas l’ID inversé ni un secret client."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quellennamen eingeben und dieselbe ursprüngliche <b>OAuth-Client-ID</b> einfügen. Keine umgekehrte ID und kein Secret einfügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un nombre de fuente y pega el mismo <b>ID de cliente OAuth</b> original. No pegues el ID inverso ni un secreto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソース名を入力し、元の <b>OAuth クライアント ID</b> を貼り付けます。逆順 ID やシークレットは使いません。"
          }
        }
      }
    },
    "guide.drive.113": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start the connection and choose an account already listed under Test users."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始连接，选择已加入测试用户列表的账户。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez la connexion et choisissez un compte déjà ajouté aux utilisateurs de test."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung starten und ein bereits eingetragenes Testkonto auswählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia la conexión y elige una cuenta ya incluida en Usuarios de prueba."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を開始し、テストユーザーに登録済みのアカウントを選びます。"
          }
        }
      }
    },
    "guide.drive.114": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve read-only Drive access. The browser should return to MusicFree, where you can browse folders and download files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同意 Drive 只读访问。浏览器应返回 MusicFree，随后可浏览文件夹和下载文件。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès Drive en lecture seule. Le navigateur revient à MusicFree pour parcourir les dossiers et télécharger des fichiers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive-Lesezugriff erlauben. Der Browser sollte zu MusicFree zurückkehren, wo Ordner durchsucht und Dateien heruntergeladen werden können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprueba el acceso de solo lectura a Drive. El navegador volverá a MusicFree, donde podrás explorar carpetas y descargar archivos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive の読み取り専用アクセスを許可します。ブラウザから MusicFree に戻ると、フォルダ閲覧やダウンロードができます。"
          }
        }
      }
    },
