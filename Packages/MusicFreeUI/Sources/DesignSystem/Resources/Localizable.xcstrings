    "来源：%@\n协议版本：%@\n协议用于浏览、下载和临时试听所需的远程目录数据。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelle: %@\nRichtlinienversion: %@\nDie Richtlinie gilt für Remote-Verzeichnisdaten, die zum Durchsuchen, Herunterladen und für die temporäre Vorschau benötigt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Source: %@\nPolicy version: %@\nThe policy covers remote directory data needed for browsing, downloading, and temporary audition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuente: %@\nVersión de la política: %@\nLa política cubre los datos de directorios remotos necesarios para explorar, descargar y escuchar temporalmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Source : %@\nVersion de la politique : %@\nLa politique couvre les données de répertoire distant nécessaires à la navigation, au téléchargement et à l’écoute temporaire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソース：%@\nポリシーバージョン：%@\nこのポリシーは、表示・ダウンロード・一時試聴に必要なリモートディレクトリ情報を対象とします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来源：%@\n协议版本：%@\n协议用于浏览、下载和临时试听所需的远程目录数据。"
          }
        }
      }
    },
    "来源：%@\n协议版本：%@\n协议用于浏览、下载和临时试听所需的远程目录数据。撤销后会立即停止此来源操作。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelle: %@\nRichtlinienversion: %@\nDie Richtlinie gilt für Remote-Verzeichnisdaten, die zum Durchsuchen, Herunterladen und für die temporäre Vorschau benötigt werden. Durch den Widerruf werden Vorgänge für diese Quelle sofort beendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Source: %@\nPolicy version: %@\nThe policy covers remote directory data needed for browsing, downloading, and temporary audition. Revoking it immediately stops operations for this source."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuente: %@\nVersión de la política: %@\nLa política cubre los datos de directorios remotos necesarios para explorar, descargar y escuchar temporalmente. Al revocarla, las operaciones de esta fuente se detienen de inmediato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Source : %@\nVersion de la politique : %@\nLa politique couvre les données de répertoire distant nécessaires à la navigation, au téléchargement et à l’écoute temporaire. Sa révocation arrête immédiatement les opérations de cette source."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソース：%@\nポリシーバージョン：%@\nこのポリシーは、表示・ダウンロード・一時試聴に必要なリモートディレクトリ情報を対象とします。撤回すると、このソースの操作を直ちに停止します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来源：%@\n协议版本：%@\n协议用于浏览、下载和临时试听所需的远程目录数据。撤销后会立即停止此来源操作。"
          }
        }
      }
    },
