    "未同意应用隐私政策时，元数据、歌词和在线源都不会发起网络请求。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Zustimmung zur Datenschutzerklärung der App stellen Metadaten, Liedtexte und Online-Quellen keine Netzwerkanfragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metadata, lyrics, and online sources will not make network requests until you accept the app privacy policy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los metadatos, las letras y las fuentes en línea no realizarán solicitudes de red hasta que aceptes la política de privacidad de la aplicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les métadonnées, les paroles et les sources en ligne n’effectueront aucune requête réseau tant que vous n’aurez pas accepté la politique de confidentialité de l’application."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのプライバシーポリシーに同意するまで、メタデータ、歌詞、オンラインソースはネットワークに接続しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未同意应用隐私政策时，元数据、歌词和在线源都不会发起网络请求。"
          }
        }
      }
    },
    "未同意应用隐私政策时，元数据和歌词 Provider 不会发起网络请求。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metadaten- und Liedtext-Provider dürfen keine Netzwerkanfragen stellen, bevor der Datenschutzrichtlinie der App zugestimmt wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metadata and lyrics Providers cannot make network requests until the app privacy policy is accepted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los Providers de metadatos y letras no pueden realizar solicitudes de red hasta que se acepte la política de privacidad de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Providers de métadonnées et de paroles ne peuvent pas effectuer de requêtes réseau tant que la politique de confidentialité de l’app n’est pas acceptée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのプライバシーポリシーに同意するまで、メタデータと歌詞のProviderはネットワークリクエストを実行できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未同意应用隐私政策时，元数据和歌词 Provider 不会发起网络请求。"
          }
        }
      }
    },
