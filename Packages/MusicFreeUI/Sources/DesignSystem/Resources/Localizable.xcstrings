    "Online audition playback is unavailable." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Online audition playback is unavailable."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在线试听播放不可用。"}},"de":{"stringUnit":{"state":"translated","value":"Die Online-Vorschauwiedergabe ist nicht verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"La reproducción de vista previa en línea no está disponible."}},"fr":{"stringUnit":{"state":"translated","value":"La lecture d’extraits en ligne est indisponible."}},"ja":{"stringUnit":{"state":"translated","value":"オンライン試聴を再生できません。"}}}},
    "This item must be downloaded before playback." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This item must be downloaded before playback."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此项目需要先下载才能播放。"}},"de":{"stringUnit":{"state":"translated","value":"Dieses Element muss vor der Wiedergabe heruntergeladen werden."}},"es":{"stringUnit":{"state":"translated","value":"Este elemento debe descargarse antes de reproducirlo."}},"fr":{"stringUnit":{"state":"translated","value":"Cet élément doit être téléchargé avant la lecture."}},"ja":{"stringUnit":{"state":"translated","value":"この項目は再生前にダウンロードする必要があります。"}}}},
    "The temporary audition access has expired." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The temporary audition access has expired."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"临时试听访问权限已过期。"}},"de":{"stringUnit":{"state":"translated","value":"Der temporäre Vorschauzugriff ist abgelaufen."}},"es":{"stringUnit":{"state":"translated","value":"El acceso temporal a la vista previa ha caducado."}},"fr":{"stringUnit":{"state":"translated","value":"L’accès temporaire à l’extrait a expiré."}},"ja":{"stringUnit":{"state":"translated","value":"一時的な試聴アクセスの有効期限が切れました。"}}}},
    "There are no playable songs to audition." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"There are no playable songs to audition."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有可试听的歌曲。"}},"de":{"stringUnit":{"state":"translated","value":"Es gibt keine abspielbaren Titel für die Vorschau."}},"es":{"stringUnit":{"state":"translated","value":"No hay canciones reproducibles para la vista previa."}},"fr":{"stringUnit":{"state":"translated","value":"Aucun morceau ne peut être lu en extrait."}},"ja":{"stringUnit":{"state":"translated","value":"試聴できる曲がありません。"}}}},
    "The selected song is no longer in the audition list." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The selected song is no longer in the audition list."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所选歌曲已不在试听列表中。"}},"de":{"stringUnit":{"state":"translated","value":"Der ausgewählte Titel ist nicht mehr in der Vorschau-Liste."}},"es":{"stringUnit":{"state":"translated","value":"La canción seleccionada ya no está en la lista de vista previa."}},"fr":{"stringUnit":{"state":"translated","value":"Le morceau sélectionné ne figure plus dans la liste d’extraits."}},"ja":{"stringUnit":{"state":"translated","value":"選択した曲は試聴リストにありません。"}}}},
    "Seeking is unavailable for this audition." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Seeking is unavailable for this audition."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此试听无法调整播放进度。"}},"de":{"stringUnit":{"state":"translated","value":"Für diese Vorschau ist keine Positionssuche verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"No se puede cambiar la posición de reproducción en esta vista previa."}},"fr":{"stringUnit":{"state":"translated","value":"Le déplacement dans cet extrait est indisponible."}},"ja":{"stringUnit":{"state":"translated","value":"この試聴では再生位置を変更できません。"}}}},
