    "未同意应用隐私政策时，元数据和歌词 Provider 不会发起网络请求。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Metadata and lyrics Providers cannot make network requests until the app privacy policy is accepted." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未同意应用隐私政策时，元数据和歌词 Provider 不会发起网络请求。" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les Providers de métadonnées et de paroles ne peuvent pas effectuer de requêtes réseau tant que la politique de confidentialité de l’app n’est pas acceptée." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Metadaten- und Liedtext-Provider dürfen keine Netzwerkanfragen stellen, bevor der Datenschutzrichtlinie der App zugestimmt wurde." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Los Providers de metadatos y letras no pueden realizar solicitudes de red hasta que se acepte la política de privacidad de la app." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "アプリのプライバシーポリシーに同意するまで、メタデータと歌詞のProviderはネットワークリクエストを実行できません。" } }
      }
    },
    "请先同意应用隐私政策，才能启用此 Provider。" : {
