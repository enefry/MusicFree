    "guide.drive.033": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<strong>Do not copy rclone's Desktop app step.</strong> rclone normally creates a Desktop client and uses a Client ID plus Client Secret. MusicFree is an iOS app: create an <b>iOS client</b> for <span class=\"mono\">win.tools4me.music</span> and use only its Client ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<strong>请勿照搬 rclone 的桌面应用步骤。</strong>rclone 通常创建桌面客户端并使用客户端 ID 和密钥。MusicFree 是 iOS 应用：请创建 <b>iOS 客户端</b>，Bundle ID 使用 <span class=\"mono\">win.tools4me.music</span>，仅使用客户端 ID。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<strong>Ne suivez pas l’étape rclone pour une app de bureau.</strong> rclone crée généralement un client de bureau avec ID et secret client. MusicFree est une app iOS : créez un <b>client iOS</b> pour <span class=\"mono\">win.tools4me.music</span> et utilisez uniquement son ID client."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<strong>Übernehmen Sie nicht den Desktop-Schritt von rclone.</strong> rclone nutzt normalerweise einen Desktop-Client mit Client-ID und Secret. MusicFree ist eine iOS-App: Erstellen Sie einen <b>iOS-Client</b> für <span class=\"mono\">win.tools4me.music</span> und verwenden Sie nur dessen Client-ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<strong>No copies el paso de aplicación de escritorio de rclone.</strong> rclone suele crear un cliente de escritorio con ID y secreto. MusicFree es una app iOS: crea un <b>cliente iOS</b> para <span class=\"mono\">win.tools4me.music</span> y usa solo su ID."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<strong>rclone のデスクトップアプリ向け手順を使わないでください。</strong>rclone は通常 ID とシークレットを使うデスクトップクライアントを作成します。MusicFree は iOS アプリなので、<b>iOS クライアント</b>を作り、バンドル ID を <span class=\"mono\">win.tools4me.music</span> にして、クライアント ID のみを使用します。"
          }
        }
      }
    },
