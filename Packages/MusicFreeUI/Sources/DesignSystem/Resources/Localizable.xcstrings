    "仅用于未来 Provider 支持的在线源功能。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur für Online-Quellfunktionen, die von zukünftigen Providern unterstützt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For online-source features supported by future providers only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo para funciones de fuentes en línea compatibles con futuros proveedores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réservé aux fonctions de sources en ligne prises en charge par de futurs fournisseurs."
          }
        },
        "ja" : {
          "stringUnit" : {
