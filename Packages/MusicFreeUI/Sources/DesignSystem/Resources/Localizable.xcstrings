    "关闭 Provider 后不再发送新的请求；已经由第三方服务接收的请求日志由其隐私政策管理。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach der Deaktivierung eines Providers werden keine neuen Anfragen gesendet; bereits vom Drittanbieter empfangene Anfragelogs unterliegen dessen Datenschutzrichtlinie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After a Provider is disabled, no new requests are sent; request logs already received by the third party are governed by its privacy policy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de desactivar un Provider, no se envían nuevas solicitudes; los registros de solicitudes que ya haya recibido el tercero se rigen por su política de privacidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après la désactivation d’un Provider, aucune nouvelle requête n’est envoyée ; les journaux déjà reçus par le service tiers sont régis par sa politique de confidentialité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Providerを無効にすると新しいリクエストは送信されません。第三者サービスがすでに受け取ったリクエストログは、そのプライバシーポリシーに従って扱われます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭 Provider 后不再发送新的请求；已经由第三方服务接收的请求日志由其隐私政策管理。"
          }
        }
      }
    },
