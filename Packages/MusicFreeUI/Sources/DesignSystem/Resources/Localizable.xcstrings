    "guide.drive.146": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<a href=\"https://developers.google.com/identity/protocols/oauth2/native-app\" target=\"_blank\" rel=\"noreferrer\">Google OAuth 2.0 for iOS &amp; Desktop Apps</a> — the native OAuth and PKCE reference for this project."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<a href=\"https://developers.google.com/identity/protocols/oauth2/native-app\" target=\"_blank\" rel=\"noreferrer\">Google OAuth 2.0：iOS 与桌面应用</a>——本项目原生 OAuth 与 PKCE 的参考。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<a href=\"https://developers.google.com/identity/protocols/oauth2/native-app\" target=\"_blank\" rel=\"noreferrer\">Google OAuth 2.0 pour iOS et les apps de bureau</a> — référence OAuth natif et PKCE de ce projet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<a href=\"https://developers.google.com/identity/protocols/oauth2/native-app\" target=\"_blank\" rel=\"noreferrer\">Google OAuth 2.0 für iOS und Desktop-Apps</a> — Referenz für natives OAuth und PKCE in diesem Projekt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<a href=\"https://developers.google.com/identity/protocols/oauth2/native-app\" target=\"_blank\" rel=\"noreferrer\">Google OAuth 2.0 para iOS y escritorio</a> — referencia de OAuth nativo y PKCE del proyecto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<a href=\"https://developers.google.com/identity/protocols/oauth2/native-app\" target=\"_blank\" rel=\"noreferrer\">iOS・デスクトップ向け Google OAuth 2.0</a> — このプロジェクトのネイティブ OAuth と PKCE の資料。"
