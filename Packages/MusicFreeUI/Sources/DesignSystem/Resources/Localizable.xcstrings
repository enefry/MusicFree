            "value": "C. データアクセス"
          }
        }
      }
    },
    "guide.drive.073": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicFree browses and downloads files. It does not upload, rename, or delete them, so add only this read-only scope:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicFree 仅浏览和下载文件，不上传、重命名或删除，因此只需添加以下只读权限范围："
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicFree parcourt et télécharge les fichiers, sans les envoyer, les renommer ni les supprimer. Ajoutez uniquement cette autorisation en lecture seule :"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicFree durchsucht und lädt Dateien herunter, ohne sie hochzuladen, umzubenennen oder zu löschen. Fügen Sie nur diesen Lesezugriff hinzu:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicFree explora y descarga archivos, sin subirlos, renombrarlos ni eliminarlos. Añade solo este permiso de lectura:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicFree は閲覧とダウンロードのみを行い、アップロード、名前変更、削除は行いません。次の読み取り専用スコープだけを追加します："
          }
        }
      }
    },
    "guide.drive.074": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Data Access and tap <b>Add or remove scopes</b>."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开数据访问，点击<b>添加或移除权限范围</b>。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Accès aux données et touchez <b>Ajouter ou supprimer des champs d’application</b>."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datenzugriff öffnen und <b>Bereiche hinzufügen oder entfernen</b> wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Acceso a datos y pulsa <b>Añadir o quitar permisos</b>."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データアクセスから<b>スコープを追加または削除</b>を選びます。"
          }
        }
      }
    },
    "guide.drive.075": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search for the scope above, or add the full value manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索上述权限范围，或手动添加完整值。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez le champ ci-dessus ou ajoutez sa valeur complète manuellement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den obigen Bereich suchen oder den vollständigen Wert manuell hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca el permiso anterior o añade el valor completo manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上記のスコープを検索するか、完全な値を手入力します。"
          }
        }
      }
    },
    "guide.drive.076": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Update, then Save. Do not replace it with the broader <span class=\"mono\">drive</span> scope."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击更新再保存。请勿改用权限更大的 <span class=\"mono\">drive</span> 范围。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Mettre à jour, puis Enregistrer. Ne le remplacez pas par le champ plus large <span class=\"mono\">drive</span>."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren und Speichern wählen. Nicht durch den umfassenderen Bereich <span class=\"mono\">drive</span> ersetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa Actualizar y Guardar. No lo sustituyas por el permiso más amplio <span class=\"mono\">drive</span>."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新して保存します。より広い権限の <span class=\"mono\">drive</span> に置き換えないでください。"
          }
        }
      }
    },
    "guide.drive.077": {
      "extractionState": "manual",
      "localizations": {
