    "guide.drive.098": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<strong>Where does the reversed ID come from?</strong> Download the iOS configuration plist from Google and copy <span class=\"mono\">CLIENT_ID</span> and <span class=\"mono\">REVERSED_CLIENT_ID</span>. MusicFree uses the values from xcconfig at runtime; the plist is reference material only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<strong>反向 ID 从哪里获得？</strong>从 Google 下载 iOS 配置 plist，复制 <span class=\"mono\">CLIENT_ID</span> 和 <span class=\"mono\">REVERSED_CLIENT_ID</span>。MusicFree 运行时使用 xcconfig 中的值；plist 仅供参考。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<strong>D’où vient l’ID inversé ?</strong> Téléchargez le plist de configuration iOS de Google et copiez <span class=\"mono\">CLIENT_ID</span> et <span class=\"mono\">REVERSED_CLIENT_ID</span>. MusicFree utilise les valeurs du xcconfig à l’exécution ; le plist sert uniquement de référence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<strong>Woher kommt die umgekehrte ID?</strong> Den iOS-Konfigurations-plist von Google herunterladen und <span class=\"mono\">CLIENT_ID</span> sowie <span class=\"mono\">REVERSED_CLIENT_ID</span> kopieren. MusicFree nutzt zur Laufzeit die xcconfig-Werte; der plist dient nur als Referenz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<strong>¿De dónde sale el ID inverso?</strong> Descarga el plist de configuración iOS de Google y copia <span class=\"mono\">CLIENT_ID</span> y <span class=\"mono\">REVERSED_CLIENT_ID</span>. MusicFree usa los valores de xcconfig en ejecución; el plist es solo una referencia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<strong>逆順 ID の取得方法：</strong>Google から iOS 設定 plist をダウンロードし、<span class=\"mono\">CLIENT_ID</span> と <span class=\"mono\">REVERSED_CLIENT_ID</span> をコピーします。実行時は xcconfig の値を使い、plist は参照用です。"
          }
        }
      }
    },
