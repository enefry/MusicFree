    "歌曲仍会保留在资料库中，累计播放统计不会重置。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Songs will remain in the library, and cumulative play statistics will not reset."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歌曲仍会保留在资料库中，累计播放统计不会重置。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les chansons resteront dans la bibliothèque et les statistiques de lecture cumulées ne seront pas réinitialisées."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Songs bleiben in der Mediathek und die kumulierten Wiedergabestatistiken werden nicht zurückgesetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las canciones permanecerán en la biblioteca y las estadísticas de reproducción acumuladas no se restablecerán."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲はライブラリに残り、累積再生統計はリセットされません。"
          }
        }
      }
    },
    "歌曲会从当前歌单移除，资料库中的原曲不会被删除。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Songs will be removed from the current playlist. The original library tracks will not be deleted."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歌曲会从当前歌单移除，资料库中的原曲不会被删除。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les chansons seront retirées de la playlist actuelle. Les pistes originales de la bibliothèque ne seront pas supprimées."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Songs werden aus der aktuellen Wiedergabeliste entfernt. Die ursprünglichen Titel in der Mediathek werden nicht gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las canciones se eliminarán de la lista de reproducción actual. Las pistas originales de la biblioteca no se eliminarán."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲は現在のプレイリストから削除されます。ライブラリの元の曲は削除されません。"
          }
        }
      }
    },
