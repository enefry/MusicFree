    "删除导入流程留下的暂存副本。只处理暂存目录，不影响已经进入资料库的媒体文件。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht die vom Importvorgang hinterlassenen Staging-Kopien. Nur das Staging-Verzeichnis wird bearbeitet; Medien in der Mediathek bleiben unberührt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes staging copies left by the import flow. Only the staging directory is handled; media already in the library is not affected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina las copias de preparación que dejó la importación. Solo se procesa el directorio de preparación; los archivos multimedia que ya están en la biblioteca no se ven afectados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime les copies de préparation laissées par l’importation. Seul le dossier de préparation est traité ; les fichiers multimédias déjà présents dans la bibliothèque ne sont pas affectés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み込み処理で残ったステージングのコピーを削除します。ステージングディレクトリだけを処理し、ライブラリに取り込まれたメディアファイルには影響しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除导入流程留下的暂存副本。只处理暂存目录，不影响已经进入资料库的媒体文件。"
          }
        }
      }
    },
