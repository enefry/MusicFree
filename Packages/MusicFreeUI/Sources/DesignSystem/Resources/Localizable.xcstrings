    "policy.lrclib.005": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This document is an application-provided privacy disclosure for MyMusic: Local Player's optional use of the LRCLIB lyrics service. It is not a privacy policy issued by LRCLIB, does not represent LRCLIB, and cannot change how the LRCLIB service operates."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本文件由应用提供，说明 MyMusic: Local Player 可选使用 LRCLIB 歌词服务时的隐私事项。它不是 LRCLIB 发布的隐私政策，不代表 LRCLIB，也无法改变该服务的运作方式。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce document présente les informations de confidentialité fournies par MyMusic: Local Player pour son utilisation facultative du service de paroles LRCLIB. Il ne s’agit pas d’une politique publiée par LRCLIB, ne représente pas LRCLIB et ne peut modifier son fonctionnement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Dokument enthält Datenschutzhinweise der App zur optionalen Nutzung des Liedtextdienstes LRCLIB durch MyMusic: Local Player. Es ist keine von LRCLIB veröffentlichte Datenschutzrichtlinie, vertritt LRCLIB nicht und kann dessen Betrieb nicht ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento es un aviso de privacidad de MyMusic: Local Player sobre el uso opcional del servicio de letras LRCLIB. No es una política publicada por LRCLIB, no representa a LRCLIB ni puede modificar su funcionamiento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本書は MyMusic: Local Player が任意で利用する LRCLIB 歌詞サービスについて、アプリが提供するプライバシー説明です。LRCLIB が発行したポリシーではなく、LRCLIB を代表せず、サービスの運用を変更するものでもありません。"
          }
        }
      }
    },
    "policy.lrclib.006": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app provides this disclosure because it does not have an official LRCLIB privacy-policy text to link to. The service may publish or change its own terms independently; users should review the latest information on the <a href=\"https://lrclib.net/\">LRCLIB website</a> and its <a href=\"https://lrclib.net/docs/\">API documentation</a> where available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用提供本说明，是因为没有可链接的 LRCLIB 官方隐私政策文本。服务可能独立发布或修改条款；请查看 <a href=\"https://lrclib.net/\">LRCLIB 网站</a>及其<a href=\"https://lrclib.net/docs/\"> API 文档</a>中的最新信息。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’application fournit ces informations faute de texte officiel de confidentialité LRCLIB à référencer. Le service peut publier ou modifier ses conditions indépendamment ; consultez les informations récentes sur le <a href=\"https://lrclib.net/\">site LRCLIB</a> et sa <a href=\"https://lrclib.net/docs/\">documentation API</a>, lorsqu’elles sont disponibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App stellt diese Hinweise bereit, da kein offizieller LRCLIB-Datenschutztext zur Verlinkung vorliegt. Der Dienst kann eigene Bedingungen unabhängig veröffentlichen oder ändern. Aktuelle Informationen finden Sie auf der <a href=\"https://lrclib.net/\">LRCLIB-Website</a> und in der <a href=\"https://lrclib.net/docs/\">API-Dokumentation</a>, soweit verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app ofrece este aviso porque no dispone de un texto oficial de privacidad de LRCLIB para enlazar. El servicio puede publicar o cambiar sus condiciones por su cuenta; consulta la información más reciente en el <a href=\"https://lrclib.net/\">sitio de LRCLIB</a> y su <a href=\"https://lrclib.net/docs/\">documentación de la API</a>, cuando estén disponibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンク可能な LRCLIB 公式プライバシーポリシーの本文がないため、アプリが本説明を提供しています。サービスは独自に規約を公開・変更する場合があります。<a href=\"https://lrclib.net/\">LRCLIB のサイト</a>と<a href=\"https://lrclib.net/docs/\"> API ドキュメント</a>で最新情報をご確認ください。"
          }
        }
      }
    },
    "policy.lrclib.007": {
      "extractionState": "manual",
      "localizations": {
