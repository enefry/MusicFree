    "Apple Music catalog 可用；本地已有信息不会被覆盖。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Apple-Music-Katalog ist verfügbar; vorhandene lokale Informationen werden nicht überschrieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Music catalog is available; existing local information will not be overwritten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El catálogo de Apple Music está disponible; no se sobrescribirá la información local existente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le catalogue Apple Music est disponible ; les informations locales existantes ne seront pas remplacées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Musicカタログを利用できます。既存のローカル情報は上書きしません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Music catalog 可用；本地已有信息不会被覆盖。"
          }
        }
      }
    },
    "Apple Music catalog 权限已拒绝，请在系统设置中允许。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriff auf den Apple-Music-Katalog wurde abgelehnt. Erlauben Sie ihn in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Music catalog access was denied. Allow it in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se denegó el acceso al catálogo de Apple Music. Permítelo en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès au catalogue Apple Music a été refusé. Autorisez-le dans Réglages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Musicカタログへのアクセスが拒否されました。設定で許可してください。"
