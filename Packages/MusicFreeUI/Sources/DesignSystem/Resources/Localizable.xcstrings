    "启用 Provider 时才会要求确认对应服务说明；未启用的 Provider 不会发起请求。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Informationen zum Provider-Dienst werden nur beim Aktivieren des Providers bestätigt; deaktivierte Provider senden keine Anfragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Provider service disclosure is requested only when you enable that Provider; disabled Providers make no requests."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La información del servicio de un Provider solo se solicita al activarlo; los Providers desactivados no realizan solicitudes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les informations sur le service d’un Provider ne sont demandées que lorsque vous l’activez ; les Providers désactivés n’envoient aucune requête."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Providerを有効にしたときだけ、そのサービス情報への同意を求めます。無効なProviderはリクエストを送信しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用 Provider 时才会要求确认对应服务说明；未启用的 Provider 不会发起请求。"
          }
        }
      }
    },
