    "policy.lrclib.011": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Depending on the metadata available for the local song, the lookup request may include:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据本地歌曲可用的元数据，查询可能包含："
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Selon les métadonnées disponibles pour le morceau local, la requête peut inclure :"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abhängig von den verfügbaren Metadaten des lokalen Titels kann die Anfrage Folgendes enthalten:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Según los metadatos disponibles de la canción local, la consulta puede incluir:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカル曲のメタデータに応じて、検索に次の情報が含まれる場合があります。"
          }
        }
      }
    },
    "policy.lrclib.012": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<code>track_name</code>: the song title;"
