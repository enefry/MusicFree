      }
    },
    "Provider 同意独立保存；撤回后会同时关闭对应 Provider，未启用的 Provider 不会发起请求。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Provider consent is stored independently; withdrawing it also disables the corresponding Provider, and disabled Providers make no requests." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Provider 同意独立保存；撤回后会同时关闭对应 Provider，未启用的 Provider 不会发起请求。" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le consentement de chaque Provider est enregistré séparément ; son retrait désactive également le Provider correspondant, et les Providers désactivés n’envoient aucune requête." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Zustimmung zu den Providern wird unabhängig gespeichert; ein Widerruf deaktiviert den jeweiligen Provider ebenfalls, und deaktivierte Provider senden keine Anfragen." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El consentimiento de cada Provider se guarda por separado; retirarlo también desactiva el Provider correspondiente y los Providers desactivados no realizan solicitudes." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Providerごとの同意は個別に保存されます。同意を撤回すると対応するProviderも無効になり、無効なProviderはリクエストを送信しません。" } }
      }
    },
