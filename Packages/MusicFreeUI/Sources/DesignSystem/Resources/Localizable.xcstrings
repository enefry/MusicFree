    "guide.drive.014": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The only value you paste into MusicFree is a public Client ID:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴到 MusicFree 的唯一值是公开的客户端 ID："
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La seule valeur à coller dans MusicFree est un ID client public :"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In MusicFree fügen Sie nur eine öffentliche Client-ID ein:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El único valor que debes pegar en MusicFree es un ID de cliente público:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicFree に貼り付ける値は公開クライアント ID のみです："
          }
        }
      }
    },
    "guide.drive.015": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An iOS app cannot keep a client secret confidential. MusicFree does not need one, and you should never add one to the project."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 应用无法保密客户端密钥。MusicFree 不需要它，请勿将其加入项目。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une app iOS ne peut pas protéger un secret client. MusicFree n’en a pas besoin ; ne l’ajoutez jamais au projet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine iOS-App kann ein Client-Secret nicht geheim halten. MusicFree benötigt keines; fügen Sie keines zum Projekt hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una app iOS no puede mantener un secreto de cliente confidencial. MusicFree no lo necesita; nunca lo añadas al proyecto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS アプリはクライアントシークレットを秘密に保持できません。MusicFree では不要なので、プロジェクトへ追加しないでください。"
          }
        }
      }
    },
