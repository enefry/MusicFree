        }
      }
    },
    "开启后需要 Apple Music catalog 权限；只补充元数据和封面。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach der Aktivierung ist der Zugriff auf den Apple-Music-Katalog erforderlich; nur Metadaten und Cover werden ergänzt."
          }
        },
