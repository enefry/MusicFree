        "en" : { "stringUnit" : { "state" : "translated", "value" : "Purpose" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用途" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Objectif" } },
