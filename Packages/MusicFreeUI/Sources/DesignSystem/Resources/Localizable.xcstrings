    "检查未完成的删除事务，并根据资料库记录恢复或完成事务。不会重新删除资料库中的媒体文件。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüft unvollständige Löschvorgänge und stellt sie anhand der Mediatheksdaten wieder her oder schließt sie ab. Medien in der Mediathek werden nicht erneut gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checks unfinished removal transactions and restores or completes them according to library records. It does not delete library media again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba las transacciones de eliminación sin terminar y las restaura o completa según los registros de la biblioteca. Los archivos multimedia de la biblioteca no se eliminan de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie les transactions de suppression inachevées et les restaure ou les termine selon les enregistrements de la bibliothèque. Les fichiers multimédias de la bibliothèque ne sont pas supprimés à nouveau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未完了の削除処理を確認し、ライブラリの記録に基づいて復元または完了します。ライブラリのメディアファイルを再度削除することはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查未完成的删除事务，并根据资料库记录恢复或完成事务。不会重新删除资料库中的媒体文件。"
          }
        }
      }
    },
    "检测到相同内容时跳过导入，避免资料库出现重复歌曲。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übereinstimmende Inhalte beim Import überspringen, um doppelte Songs in der Mediathek zu vermeiden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skip matching content during import to avoid duplicate songs in the library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omitir el contenido coincidente durante la importación para evitar canciones duplicadas en la biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignorer le contenu correspondant lors de l’importation pour éviter les doublons dans la bibliothèque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み込み時に一致するコンテンツをスキップし、ライブラリ内の曲の重複を防ぎます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检测到相同内容时跳过导入，避免资料库出现重复歌曲。"
          }
        }
      }
    },
