    "总线混音后" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After mixing the output"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总线混音后"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après le mixage de sortie"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Mischen der Ausgabe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de mezclar la salida"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出力のミックス後"
          }
        }
      }
    },
    "每轨分别处理后混音；总线处理混音后的声音。更改位置在暂停或停止后生效，每个播放会话使用独立实例。" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per-track processing runs before mixing; output processing runs after mixing. Placement changes take effect when paused or stopped. Each playback session uses a separate instance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每轨分别处理后混音；总线处理混音后的声音。更改位置在暂停或停止后生效，每个播放会话使用独立实例。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le traitement par piste précède le mixage ; le traitement de sortie le suit. Les changements s’appliquent après une pause ou un arrêt. Chaque session de lecture utilise une instance distincte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel werden vor dem Mischen einzeln verarbeitet; die Ausgabe wird danach verarbeitet. Positionsänderungen gelten nach dem Pausieren oder Stoppen. Jede Wiedergabesitzung nutzt eine eigene Instanz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El procesamiento por pista se realiza antes de mezclar; el de salida, después. Los cambios se aplican tras pausar o detener. Cada sesión usa una instancia independiente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各トラックの処理はミックス前に、出力の処理はミックス後に行われます。位置の変更は一時停止または停止後に反映され、再生セッションごとに別のインスタンスを使用します。"
          }
        }
      }
    },
