        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Prend en charge les paroles simples et le texte LRC horodaté. L’enregistrement met uniquement à jour la bibliothèque de l’app et ne réécrit pas les balises audio d’origine." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Unterstützt einfachen Liedtext und zeitcodierten LRC-Text. Beim Speichern wird nur die App-Mediathek aktualisiert, die ursprünglichen Audio-Tags werden nicht überschrieben." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Admite letras simples y texto LRC con marcas de tiempo. Guardar solo actualiza la biblioteca de la app y no sobrescribe las etiquetas de audio originales." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "通常の歌詞とタイムスタンプ付き LRC テキストに対応しています。保存するとアプリのライブラリだけが更新され、元の音声タグは書き換えられません。" } }
