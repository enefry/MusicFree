    "两首歌曲重叠播放的时间，最长 3 秒；选择交叉淡化后可调整。" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long two songs overlap, up to 3 seconds. Select Crossfade to adjust."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两首歌曲重叠播放的时间，最长 3 秒；选择交叉淡化后可调整。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durée de chevauchement de deux morceaux, jusqu’à 3 secondes. Sélectionnez Fondu enchaîné pour la régler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überlappungsdauer zweier Titel, maximal 3 Sekunden. Zum Anpassen Überblenden auswählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo de solapamiento de dos canciones, hasta 3 segundos. Selecciona Fundido cruzado para ajustarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2 曲を重ねて再生する時間です。最大 3 秒で、クロスフェードを選択すると調整できます。"
          }
        }
      }
    },
