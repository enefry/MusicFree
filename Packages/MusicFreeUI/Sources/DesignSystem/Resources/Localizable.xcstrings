        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開ステータスは<b>テスト</b>のままにします。"
          }
        }
      }
    },
    "guide.drive.067": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under Test users, tap <b>Add users</b> and add every Google account that will sign in on the device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在测试用户中点击<b>添加用户</b>，加入所有将在设备上登录的 Google 账户。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Utilisateurs de test, touchez <b>Ajouter des utilisateurs</b> et ajoutez chaque compte Google utilisé sur l’appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter Testnutzer <b>Nutzer hinzufügen</b> wählen und alle Google-Konten eintragen, die sich auf dem Gerät anmelden werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Usuarios de prueba, pulsa <b>Añadir usuarios</b> y añade todas las cuentas de Google que iniciarán sesión en el dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テストユーザーで<b>ユーザーを追加</b>を選び、端末でログインする Google アカウントをすべて登録します。"
          }
        }
      }
    },
    "guide.drive.068": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<strong>This is the allowlist.</strong> A project administrator is not automatically a test user. If the device account is missing, Google commonly returns <span class=\"mono\">Error 403: access_denied</span>."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<strong>这就是允许名单。</strong>项目管理员不会自动成为测试用户。缺少设备使用的账户时，Google 通常返回 <span class=\"mono\">Error 403: access_denied</span>。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<strong>C’est la liste d’autorisation.</strong> Un administrateur de projet n’est pas automatiquement utilisateur de test. Si le compte de l’appareil manque, Google renvoie souvent <span class=\"mono\">Error 403: access_denied</span>."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<strong>Dies ist die Freigabeliste.</strong> Ein Projektadministrator ist nicht automatisch Testnutzer. Fehlt das Gerätekonto, meldet Google häufig <span class=\"mono\">Error 403: access_denied</span>."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<strong>Esta es la lista de permitidos.</strong> Un administrador no es automáticamente usuario de prueba. Si falta la cuenta del dispositivo, Google suele devolver <span class=\"mono\">Error 403: access_denied</span>."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<strong>これが許可リストです。</strong>管理者でも自動的にテストユーザーにはなりません。端末のアカウントが未登録だと、通常 <span class=\"mono\">Error 403: access_denied</span> が返されます。"
          }
        }
      }
    },
    "guide.drive.069": {
      "extractionState": "manual",
      "localizations": {
