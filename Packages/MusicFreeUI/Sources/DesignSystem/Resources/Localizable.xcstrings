        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "客户端类型为 iOS，Bundle ID 为 win.tools4me.music。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le client est de type iOS et son ID de bundle est win.tools4me.music."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Clienttyp ist iOS und die Bundle-ID lautet win.tools4me.music."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cliente es de tipo iOS y su ID de paquete es win.tools4me.music."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クライアントの種類は iOS、バンドル ID は win.tools4me.music になっている。"
          }
        }
      }
    },
    "guide.drive.130": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Client ID, reversed ID, and callback URL match in the local xcconfig."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地 xcconfig 中的客户端 ID、反向 ID 和回调 URL 一致。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ID client, l’ID inversé et l’URL de rappel concordent dans le xcconfig local."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Client-ID, umgekehrte ID und Rückleitungs-URL stimmen im lokalen xcconfig überein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ID de cliente, el inverso y la URL de retorno coinciden en el xcconfig local."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカル xcconfig の ID、逆順 ID、コールバック URL が一致している。"
          }
        }
      }
    },
    "guide.drive.131": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorization returns to MusicFree and Drive folders can be browsed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权后能返回 MusicFree 并浏览 Drive 文件夹。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation revient à MusicFree et les dossiers Drive sont accessibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Autorisierung führt zu MusicFree zurück und Drive-Ordner sind zugänglich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La autorización vuelve a MusicFree y permite explorar carpetas de Drive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証後 MusicFree に戻り、Drive のフォルダを閲覧できる。"
          }
        }
      }
    },
