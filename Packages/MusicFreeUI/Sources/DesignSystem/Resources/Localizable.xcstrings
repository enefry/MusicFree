    "按启用顺序依次匹配；成功后停止。已有本地信息不会覆盖。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Sources are tried in enabled order and stop after a match. Existing local information is kept." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "按启用顺序依次匹配；成功后停止。已有本地信息不会覆盖。" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les sources sont utilisées dans l’ordre activé et s’arrêtent après une correspondance. Les informations locales existantes sont conservées." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die aktivierten Quellen werden der Reihe nach verwendet und nach einem Treffer beendet. Vorhandene lokale Informationen bleiben erhalten." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Las fuentes se prueban en el orden activado y se detienen al encontrar una coincidencia. Se conserva la información local existente." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "有効にした順にソースを試し、一致すると停止します。既存のローカル情報は保持されます。" } }
      }
    },
    "按启用顺序匹配歌词；播放页按需获取并保存，预下载只处理没有本地歌词的歌曲。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Lyrics are matched in enabled order. Player pages fetch and save them on demand; pre-download only processes songs without local lyrics." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "按启用顺序匹配歌词；播放页按需获取并保存，预下载只处理没有本地歌词的歌曲。" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les paroles sont recherchées dans l’ordre activé. La page du lecteur les récupère et les enregistre à la demande ; le pré-téléchargement ne traite que les titres sans paroles locales." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Liedtexte werden in der aktivierten Reihenfolge gesucht. Die Wiedergabeseite lädt sie bei Bedarf und speichert sie; der Vorab-Download verarbeitet nur Titel ohne lokale Liedtexte." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Las letras se buscan en el orden activado. La página del reproductor las obtiene y guarda cuando es necesario; la predescarga solo procesa canciones sin letras locales." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "歌詞は有効にした順に検索します。再生ページでは必要に応じて取得して保存し、先行ダウンロードではローカル歌詞がない曲だけを処理します。" } }
      }
    },
