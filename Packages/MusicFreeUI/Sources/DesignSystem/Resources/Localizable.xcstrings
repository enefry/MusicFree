    "guide.drive.054": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current console groups OAuth settings under <b>Google Auth Platform</b>: Branding, Audience, Data Access, and Clients. Older consoles may call this the OAuth consent screen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前控制台在 <b>Google 身份验证平台</b>中统一管理 OAuth 设置，包括品牌信息、用户范围、数据访问和客户端。旧版可能称为 OAuth 同意屏幕。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La console regroupe les réglages OAuth dans <b>Google Auth Platform</b> : Branding, Audience, Data Access et Clients. Les anciennes consoles peuvent parler d’écran de consentement OAuth."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Konsole bündelt OAuth-Einstellungen unter <b>Google Auth Platform</b>: Branding, Zielgruppe, Datenzugriff und Clients. Ältere Konsolen nennen dies möglicherweise OAuth-Zustimmungsbildschirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La consola agrupa OAuth en <b>Google Auth Platform</b>: marca, audiencia, acceso a datos y clientes. Las versiones antiguas pueden llamarlo pantalla de consentimiento de OAuth."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のコンソールでは <b>Google Auth Platform</b> にブランディング、対象、データアクセス、クライアントの設定がまとまっています。旧版では「OAuth 同意画面」と呼ばれる場合があります。"
          }
        }
      }
    },
