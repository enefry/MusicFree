        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto solo gestiona las cachés generadas por la app o las transacciones de mantenimiento registradas. Los archivos multimedia de la biblioteca no se eliminarán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette opération traite uniquement les caches générés par l’app ou les transactions de maintenance enregistrées. Les fichiers multimédias de la bibliothèque ne seront pas supprimés."
