    "guide.drive.150": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>Credential safety</b><br>\n      A Client ID is public; a refresh token is sensitive. MusicFree stores OAuth tokens in the system Keychain. Never place authorization codes, access tokens, refresh tokens, client secrets, or service-account private keys in xcconfig, screenshots, issues, or Git."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>凭据安全</b><br>客户端 ID 是公开信息；刷新令牌是敏感信息。MusicFree 将 OAuth 令牌保存在系统钥匙串中。请勿将授权码、访问令牌、刷新令牌、客户端密钥或服务账户私钥放入 xcconfig、截图、问题报告或 Git。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>Sécurité des identifiants</b><br>Un ID client est public ; un jeton d’actualisation est sensible. MusicFree stocke les jetons OAuth dans le trousseau système. Ne placez jamais de codes d’autorisation, jetons d’accès ou d’actualisation, secrets client ou clés privées de compte de service dans xcconfig, captures, tickets ou Git."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>Sicherheit der Zugangsdaten</b><br>Eine Client-ID ist öffentlich, ein Aktualisierungstoken vertraulich. MusicFree speichert OAuth-Tokens im Systemschlüsselbund. Niemals Autorisierungscodes, Zugriffs- oder Aktualisierungstokens, Client-Secrets oder private Dienstkontoschlüssel in xcconfig, Screenshots, Issues oder Git ablegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>Seguridad de credenciales</b><br>Un ID de cliente es público; un token de actualización es sensible. MusicFree guarda los tokens OAuth en el llavero del sistema. Nunca pongas códigos de autorización, tokens de acceso o actualización, secretos de cliente ni claves privadas de cuentas de servicio en xcconfig, capturas, incidencias o Git."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<b>認証情報の安全性</b><br>クライアント ID は公開情報ですが、更新トークンは機密です。MusicFree は OAuth トークンをシステムのキーチェーンに保存します。認証コード、アクセス・更新トークン、クライアントシークレット、サービスアカウント秘密鍵を xcconfig、スクリーンショット、問題報告、Git に保存しないでください。"
          }
        }
      }
    },
