    "0 秒为关闭，最长 3 秒。" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set to 0 to disable. Maximum 3 seconds."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0 秒为关闭，最长 3 秒。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "0 seconde désactive l’effet ; maximum 3 secondes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "0 Sekunden deaktiviert den Effekt, maximal 3 Sekunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "0 segundos lo desactiva; máximo 3 segundos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0 秒で無効、最大 3 秒です。"
          }
        }
      }
    },
    "上下拖动调节，松手保存。双击频段恢复为 0 dB。" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag vertically to adjust; release to save. Double-tap a band to reset it to 0 dB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下拖动调节，松手保存。双击频段恢复为 0 dB。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser verticalement pour régler, relâchez pour enregistrer. Touchez deux fois une bande pour la remettre à 0 dB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Anpassen vertikal ziehen, zum Speichern loslassen. Ein Band doppelt antippen, um es auf 0 dB zurückzusetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra verticalmente para ajustar y suelta para guardar. Toca dos veces una banda para restablecerla a 0 dB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上下にドラッグして調整し、指を離すと保存されます。帯域をダブルタップすると 0 dB に戻ります。"
          }
        }
      }
    },
