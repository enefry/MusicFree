    "只处理没有本地歌词的歌曲，成功后保存到 App 资料库。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es werden nur Titel ohne lokale Liedtexte verarbeitet. Erfolgreiche Ergebnisse werden in der App-Mediathek gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only songs without local lyrics are processed. Successful results are saved to the App library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se procesan las canciones sin letras locales. Los resultados obtenidos se guardan en la biblioteca de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les titres sans paroles locales sont traités. Les résultats obtenus sont enregistrés dans la bibliothèque de l’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカル歌詞がない曲だけを処理します。取得に成功した歌詞はアプリのライブラリに保存されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只处理没有本地歌词的歌曲，成功后保存到 App 资料库。"
          }
        }
      }
    },
    "只开启当前来源，不影响其他在线源。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die aktuelle Quelle aktivieren; andere Online-Quellen bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable only the current source; other online sources are unaffected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa solo la fuente actual; las demás fuentes en línea no se verán afectadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez uniquement la source actuelle ; les autres sources en ligne ne sont pas affectées."
          }
        },
        "ja" : {
          "stringUnit" : {
