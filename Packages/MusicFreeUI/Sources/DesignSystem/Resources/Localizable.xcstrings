    "guide.drive.134": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Google Auth Platform → Audience → Test users and add the exact Google account selected on the device. Project administrators and test users are separate roles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Google 身份验证平台 → 用户范围 → 测试用户，添加设备上选择的同一个 Google 账户。项目管理员与测试用户是不同角色。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Google Auth Platform → Audience → Utilisateurs de test et ajoutez exactement le compte choisi sur l’appareil. Administrateurs et utilisateurs de test sont des rôles distincts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter Google Auth Platform → Zielgruppe → Testnutzer genau das auf dem Gerät gewählte Konto hinzufügen. Projektadministratoren und Testnutzer sind unterschiedliche Rollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Google Auth Platform → Audiencia → Usuarios de prueba y añade exactamente la cuenta elegida en el dispositivo. Administradores y usuarios de prueba son roles distintos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Auth Platform → 対象 → テストユーザーで、端末と同じ Google アカウントを追加します。管理者とテストユーザーは別の役割です。"
          }
        }
      }
    },
    "guide.drive.135": {
      "extractionState": "manual",
      "localizations": {
