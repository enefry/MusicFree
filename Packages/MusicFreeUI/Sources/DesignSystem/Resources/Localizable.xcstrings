    "policy.lrclib.008": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LRCLIB is an optional lyrics Provider. When it is enabled and the app needs lyrics for a song, the app sends a lookup request to the LRCLIB API endpoint configured for the app build. The purpose is to find plain or synchronized lyrics for that song."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LRCLIB 是可选的歌词服务。启用后，当应用需要某首歌曲的歌词时，会向当前构建配置的 LRCLIB API 地址发送查询，以查找普通歌词或同步歌词。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LRCLIB est un fournisseur de paroles facultatif. Lorsqu’il est activé et que des paroles sont nécessaires, l’application interroge le point d’accès API LRCLIB configuré pour cette version afin de trouver des paroles simples ou synchronisées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LRCLIB ist ein optionaler Liedtextanbieter. Wenn er aktiviert ist und die App Liedtexte benötigt, sendet sie eine Suchanfrage an den im Build konfigurierten LRCLIB-API-Endpunkt, um einfache oder synchronisierte Liedtexte zu finden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LRCLIB es un proveedor opcional de letras. Cuando está activado y la app necesita letras, envía una consulta al punto de acceso de la API de LRCLIB configurado en la versión para buscar letras simples o sincronizadas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LRCLIB は任意の歌詞プロバイダです。有効な状態で歌詞が必要になると、ビルドで設定された LRCLIB API エンドポイントへ検索を送り、通常または同期歌詞を取得します。"
          }
        }
      }
    },
    "policy.lrclib.009": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LRCLIB is disabled by default. The app requires acceptance of the application privacy policy and this Provider disclosure before enabling the Provider."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LRCLIB 默认关闭。启用前，必须接受应用隐私政策和本服务说明。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LRCLIB est désactivé par défaut. Son activation nécessite l’acceptation de la politique de confidentialité de l’application et de ces informations."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LRCLIB ist standardmäßig deaktiviert. Vor der Aktivierung müssen die Datenschutzrichtlinie der App und diese Hinweise akzeptiert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LRCLIB está desactivado por defecto. Para activarlo, debes aceptar la política de privacidad de la app y este aviso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LRCLIB は初期状態では無効です。有効にするには、アプリのプライバシーポリシーと本説明への同意が必要です。"
          }
        }
      }
    },
