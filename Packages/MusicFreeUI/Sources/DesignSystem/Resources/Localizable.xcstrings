    "只处理没有本地歌词的歌曲，成功后保存到 App 资料库。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es werden nur Titel ohne lokale Liedtexte verarbeitet. Erfolgreiche Ergebnisse werden in der App-Mediathek gespeichert."
          }
        },
        "en" : {
