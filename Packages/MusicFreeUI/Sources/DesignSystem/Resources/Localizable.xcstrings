    "guide.drive.079": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Google Auth Platform → Clients, then tap <b>Create client</b>."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Google 身份验证平台 → 客户端，点击<b>创建客户端</b>。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Google Auth Platform → Clients et touchez <b>Créer un client</b>."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Auth Platform → Clients öffnen und <b>Client erstellen</b> wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Google Auth Platform → Clientes y pulsa <b>Crear cliente</b>."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Auth Platform → クライアントから<b>クライアントを作成</b>を選びます。"
          }
        }
      }
    },
    "guide.drive.080": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose <b>iOS</b> as the application type. Do not choose Web application or Desktop app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用类型选择 <b>iOS</b>，不要选择网页应用或桌面应用。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez <b>iOS</b> comme type d’application, pas Application Web ni Application de bureau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Anwendungstyp <b>iOS</b> wählen, weder Web- noch Desktopanwendung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige <b>iOS</b> como tipo de aplicación, no aplicación web ni de escritorio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリケーションの種類は <b>iOS</b> を選び、ウェブやデスクトップは選びません。"
          }
        }
      }
    },
