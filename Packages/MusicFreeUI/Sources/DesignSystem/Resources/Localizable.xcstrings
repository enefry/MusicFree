    "guide.drive.065": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose <b>External</b> for personal Gmail accounts or users outside your Workspace organization."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "个人 Gmail 账户或 Workspace 组织以外的用户请选择<b>外部</b>。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez <b>Externe</b> pour les comptes Gmail personnels ou les utilisateurs hors de votre organisation Workspace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für private Gmail-Konten oder Nutzer außerhalb Ihrer Workspace-Organisation <b>Extern</b> wählen."
          }
        },
        "es": {
          "stringUnit": {
