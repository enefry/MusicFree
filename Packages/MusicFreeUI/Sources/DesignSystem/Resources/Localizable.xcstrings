    "guide.drive.105": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<strong>The callback must match exactly:</strong><br>\n        <span class=\"mono\">REVERSED_CLIENT_ID:/oauth2redirect/google</span><br>\n        It uses a colon and one slash (<span class=\"mono\">:/</span>), not the double slash used by web URLs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<strong>回调必须完全一致：</strong><br><span class=\"mono\">REVERSED_CLIENT_ID:/oauth2redirect/google</span><br>使用冒号和一个斜杠（<span class=\"mono\">:/</span>），不是网页 URL 中的双斜杠。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<strong>Le rappel doit correspondre exactement :</strong><br><span class=\"mono\">REVERSED_CLIENT_ID:/oauth2redirect/google</span><br>Il utilise deux-points et une barre oblique (<span class=\"mono\">:/</span>), pas la double barre des URL Web."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<strong>Die Rückleitung muss exakt übereinstimmen:</strong><br><span class=\"mono\">REVERSED_CLIENT_ID:/oauth2redirect/google</span><br>Sie nutzt Doppelpunkt und einen Schrägstrich (<span class=\"mono\">:/</span>), nicht zwei wie Web-URLs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<strong>El retorno debe coincidir exactamente:</strong><br><span class=\"mono\">REVERSED_CLIENT_ID:/oauth2redirect/google</span><br>Usa dos puntos y una barra (<span class=\"mono\">:/</span>), no las dos barras de las URLs web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<strong>コールバックは完全に一致させます：</strong><br><span class=\"mono\">REVERSED_CLIENT_ID:/oauth2redirect/google</span><br>コロンと 1 本のスラッシュ（<span class=\"mono\">:/</span>）を使います。ウェブ URL の 2 本ではありません。"
          }
        }
      }
    },
    "guide.drive.106": {
      "extractionState": "manual",
      "localizations": {
