        "de" : { "stringUnit" : { "state" : "translated", "value" : "Speicherwartung" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Mantenimiento del almacenamiento" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ストレージのメンテナンス" } }
      }
    },
    "清理暂存、修复删除事务或清理已完成的隔离文件。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Clear staging, repair removal transactions, or clear finalized quarantine files." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "清理暂存、修复删除事务或清理已完成的隔离文件。" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Nettoyer la zone de préparation, réparer les transactions de suppression ou supprimer les fichiers de quarantaine finalisés." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Staging bereinigen, Löschvorgänge reparieren oder abgeschlossene Quarantänedateien bereinigen." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Limpia el área de preparación, repara las transacciones de eliminación o limpia los archivos de cuarentena finalizados." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ステージングを消去し、削除処理を修復するか、完了した隔離ファイルを消去します。" } }
      }
    },
    "操作前请确认" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Review before continuing" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "操作前请确认" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vérifier avant de continuer" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Vor dem Fortfahren prüfen" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Revisar antes de continuar" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "続行する前に確認" } }
      }
    },
    "这些操作只处理应用生成的暂存、隔离文件和已记录的维护事务。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "These actions only handle app-generated staging files, quarantine files, and recorded maintenance transactions." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这些操作只处理应用生成的暂存、隔离文件和已记录的维护事务。" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ces opérations traitent uniquement les fichiers de préparation et de quarantaine générés par l’app, ainsi que les transactions de maintenance enregistrées." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese Vorgänge bearbeiten nur von der App erzeugte Staging- und Quarantänedateien sowie aufgezeichnete Wartungsvorgänge." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Estas operaciones solo gestionan archivos de preparación y cuarentena generados por la app, además de las transacciones de mantenimiento registradas." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "これらの操作は、アプリが生成したステージングファイル、隔離ファイル、記録済みのメンテナンス処理だけを扱います。" } }
      }
    },
    "不会删除已经进入资料库的媒体文件。清理已完成的文件后，不能从隔离目录恢复这些副本。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Library media files will not be deleted. After finalized files are cleared, those copies cannot be restored from quarantine." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不会删除已经进入资料库的媒体文件。清理已完成的文件后，不能从隔离目录恢复这些副本。" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les fichiers multimédias déjà ajoutés à la bibliothèque ne seront pas supprimés. Après la suppression des fichiers finalisés, ces copies ne pourront pas être restaurées depuis la quarantaine." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Medien, die bereits in der Mediathek sind, werden nicht gelöscht. Nach dem Bereinigen abgeschlossener Dateien können diese Kopien nicht aus der Quarantäne wiederhergestellt werden." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Los archivos multimedia que ya están en la biblioteca no se eliminarán. Después de limpiar los archivos finalizados, esas copias no se podrán restaurar desde la cuarentena." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ライブラリに取り込まれたメディアファイルは削除されません。完了済みのファイルを消去すると、これらのコピーは隔離領域から復元できません。" } }
      }
    },
