    "选择插件管理启用、许可和配置。隐藏入口不会停止已经启用的能力。" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a plugin to manage its capabilities, consent and configuration. Hiding its entry does not stop enabled capabilities."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择插件管理启用、许可和配置。隐藏入口不会停止已经启用的能力。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un plugin pour gérer son activation, ses autorisations et sa configuration. Masquer son entrée n’arrête pas ses fonctions actives."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugin auswählen, um Aktivierung, Zustimmung und Konfiguration zu verwalten. Ausblenden beendet keine aktiven Funktionen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un complemento para gestionar su activación, permisos y configuración. Ocultarlo no detiene las funciones activas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プラグインを選択して有効化、同意、設定を管理します。入口を非表示にしても有効な機能は停止しません。"
          }
        }
      }
    },
