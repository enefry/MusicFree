    "开启后才允许已授权来源联网。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisierte Quellen dürfen erst nach der Aktivierung eine Netzwerkverbindung herstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authorized sources can connect to the network only after this is enabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fuentes autorizadas solo pueden conectarse a la red después de activar esta opción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sources autorisées ne peuvent accéder au réseau qu’après activation."
