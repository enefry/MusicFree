    "policy.lrclib.015": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<code>duration</code>: the duration in seconds, when available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<code>duration</code>：以秒计的时长（如有）。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<code>duration</code> : la durée en secondes, si disponible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<code>duration</code>: Dauer in Sekunden, falls verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<code>duration</code>: duración en segundos, si está disponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<code>duration</code>：秒単位の再生時間（存在する場合）。"
          }
        }
      }
    },
    "policy.lrclib.016": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app also sends the normal HTTP headers needed for the request, including <code>Accept: application/json</code> and the app User-Agent <code>MusicFree/1.0</code>."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用也会发送请求所需的常规 HTTP 标头，包括 <code>Accept: application/json</code> 和应用 User-Agent <code>MusicFree/1.0</code>。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’application envoie également les en-têtes HTTP nécessaires, dont <code>Accept: application/json</code> et son User-Agent <code>MusicFree/1.0</code>."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App sendet außerdem die üblichen erforderlichen HTTP-Header, darunter <code>Accept: application/json</code> und den App-User-Agent <code>MusicFree/1.0</code>."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app también envía las cabeceras HTTP habituales necesarias, incluidas <code>Accept: application/json</code> y el User-Agent <code>MusicFree/1.0</code>."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要な通常の HTTP ヘッダー（<code>Accept: application/json</code>、User-Agent <code>MusicFree/1.0</code> など）も送信します。"
          }
        }
      }
    },
    "policy.lrclib.017": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app does not intentionally send audio bytes, complete local file paths, the full music library, local account credentials, contacts, advertising identifiers, or an LRCLIB login credential. The app does not require an LRCLIB account or access token for this Provider."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用不会主动发送音频数据、完整本地路径、整个音乐库、本地账户凭据、联系人、广告标识符或 LRCLIB 登录凭据。此服务不要求 LRCLIB 账户或访问令牌。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’application n’envoie pas intentionnellement de données audio, de chemins locaux complets, de bibliothèque entière, d’identifiants de comptes locaux, de contacts, d’identifiants publicitaires ni d’identifiant de connexion LRCLIB. Aucun compte LRCLIB ni jeton d’accès n’est requis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App sendet nicht absichtlich Audiodaten, vollständige lokale Pfade, die gesamte Mediathek, lokale Kontozugangsdaten, Kontakte, Werbekennungen oder LRCLIB-Anmeldedaten. Für diesen Anbieter sind kein LRCLIB-Konto und kein Zugriffstoken erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no envía intencionadamente audio, rutas locales completas, toda la biblioteca, credenciales de cuentas locales, contactos, identificadores publicitarios ni credenciales de LRCLIB. Este proveedor no requiere cuenta ni token de acceso de LRCLIB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声データ、完全なローカルパス、音楽ライブラリ全体、ローカルアカウントの認証情報、連絡先、広告識別子、LRCLIB のログイン情報は意図的に送信しません。この機能に LRCLIB アカウントやアクセストークンは不要です。"
          }
        }
      }
    },
    "policy.lrclib.018": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server and network information"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器与网络信息"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Informations serveur et réseau"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server- und Netzwerkinformationen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Información del servidor y la red"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーとネットワークの情報"
          }
        }
      }
    },
    "policy.lrclib.019": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The LRCLIB endpoint and ordinary network infrastructure can receive the request IP address, request time, User-Agent, connection metadata, and the query values listed above. The endpoint operator may log request URLs, which can contain song title, artist, album, and duration. The app does not control the operator's logs, retention period, security practices, or disclosure practices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LRCLIB 端点及常规网络基础设施可能收到 IP 地址、请求时间、User-Agent、连接元数据及上述查询值。运营方可能记录包含曲名、艺人、专辑和时长的请求 URL。应用无法控制其日志、保留期限、安全或信息披露做法。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le point d’accès LRCLIB et l’infrastructure réseau peuvent recevoir l’adresse IP, l’heure, le User-Agent, les métadonnées de connexion et les valeurs de recherche ci-dessus. L’opérateur peut journaliser les URL contenant titre, artiste, album et durée. L’application ne contrôle ni ses journaux, ni leur conservation, ni ses pratiques de sécurité ou de divulgation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der LRCLIB-Endpunkt und die Netzwerkinfrastruktur können IP-Adresse, Anfragezeit, User-Agent, Verbindungsmetadaten und die genannten Suchwerte erhalten. Der Betreiber kann Anfrage-URLs mit Titel, Künstler, Album und Dauer protokollieren. Die App kontrolliert dessen Protokolle, Aufbewahrungsfristen sowie Sicherheits- und Offenlegungsverfahren nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de LRCLIB y la infraestructura de red pueden recibir la IP, la hora, el User-Agent, metadatos de conexión y los valores de consulta anteriores. El operador puede registrar URLs con título, artista, álbum y duración. La app no controla sus registros, plazos de conservación ni prácticas de seguridad o divulgación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LRCLIB エンドポイントと通常のネットワーク設備は、IP アドレス、時刻、User-Agent、接続情報、上記の検索値を受け取る場合があります。運営者は曲名、アーティスト、アルバム、再生時間を含む URL を記録することがあります。アプリはそのログ、保存期間、セキュリティ、開示方法を管理しません。"
          }
        }
      }
    },
    "policy.lrclib.020": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app does not send these requests to the app developer's analytics or advertising systems. Failed, rate-limited, or otherwise unsuccessful requests may be represented in the app's local diagnostic log with their request URL and HTTP status; those local logs leave the device only if the user exports or shares them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用不会将这些请求发送到开发者的分析或广告系统。失败、限流等未成功请求可能连同 URL 和 HTTP 状态记录在本地诊断日志中；只有用户导出或分享时，这些日志才会离开设备。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces requêtes ne sont pas envoyées aux systèmes d’analyse ou de publicité du développeur. Les requêtes échouées ou limitées peuvent figurer dans le journal local avec leur URL et leur statut HTTP ; ces journaux quittent l’appareil uniquement si l’utilisateur les exporte ou les partage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anfragen gehen nicht an Analyse- oder Werbesysteme des App-Entwicklers. Fehlgeschlagene oder begrenzte Anfragen können mit URL und HTTP-Status im lokalen Diagnoseprotokoll erscheinen. Diese Protokolle verlassen das Gerät nur beim Exportieren oder Teilen durch den Nutzer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas solicitudes no se envían a sistemas de análisis ni publicidad del desarrollador. Las solicitudes fallidas o limitadas pueden aparecer en el registro local con su URL y estado HTTP; esos registros solo salen del dispositivo si el usuario los exporta o comparte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの要求を開発者の分析・広告システムへ送信することはありません。失敗やレート制限などの要求は、URL と HTTP ステータスとともにローカル診断ログに記録される場合があります。ログはユーザーが書き出し・共有した場合にのみ端末外へ送られます。"
          }
        }
      }
    },
    "policy.lrclib.021": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local results and caching"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地结果与缓存"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résultats locaux et cache"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Ergebnisse und Zwischenspeicherung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultados locales y caché"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルの結果とキャッシュ"
          }
        }
      }
    },
    "policy.lrclib.022": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyrics returned by LRCLIB may be saved in the app's local library so later playback can use the local result without repeating the online lookup. The app does not intentionally upload the saved lyrics or the local library to the app developer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LRCLIB 返回的歌词可能保存在本地音乐库，供后续播放直接使用，避免重复联网查询。应用不会主动将已保存的歌词或本地音乐库上传给开发者。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paroles reçues peuvent être enregistrées dans la bibliothèque locale afin d’être réutilisées sans nouvelle recherche en ligne. L’application ne téléverse pas intentionnellement ces paroles ni la bibliothèque locale vers le développeur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von LRCLIB gelieferte Liedtexte können lokal gespeichert und später ohne erneute Onlineabfrage genutzt werden. Die App lädt diese Texte oder die lokale Mediathek nicht absichtlich zum Entwickler hoch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las letras recibidas pueden guardarse en la biblioteca local para reutilizarlas sin repetir la búsqueda en línea. La app no sube intencionadamente esas letras ni la biblioteca local al desarrollador."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取得した歌詞はローカルライブラリに保存し、次回以降の検索なしで利用する場合があります。保存した歌詞やライブラリを開発者へ意図的にアップロードすることはありません。"
          }
        }
      }
    },
    "policy.lrclib.023": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consent and controls"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同意与控制"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consentement et contrôles"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zustimmung und Steuerung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consentimiento y controles"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同意と操作"
          }
        }
      }
    },
    "policy.lrclib.024": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The user can enable or disable LRCLIB in Settings. Disabling the Provider stops new LRCLIB requests from the app. It cannot delete request logs that the endpoint operator already received. Disabling the Provider also does not automatically delete lyrics already saved locally; those remain subject to the app's normal local-library deletion and storage controls."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户可在设置中启用或关闭 LRCLIB。关闭后不会发起新的 LRCLIB 请求，但无法删除运营方已收到的请求日志，也不会自动删除本地已保存的歌词；这些歌词仍由应用的本地音乐库删除和存储功能管理。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez activer ou désactiver LRCLIB dans Réglages. La désactivation arrête les nouvelles requêtes, mais ne supprime ni les journaux déjà reçus par l’opérateur ni les paroles enregistrées localement. Ces paroles restent gérées par les commandes habituelles de suppression et de stockage de la bibliothèque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LRCLIB lässt sich in den Einstellungen aktivieren oder deaktivieren. Deaktivieren stoppt neue Anfragen, löscht aber weder bereits empfangene Betreiberprotokolle noch lokal gespeicherte Liedtexte. Diese unterliegen weiterhin den üblichen Lösch- und Speicherfunktionen der Mediathek."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes activar o desactivar LRCLIB en Ajustes. Desactivarlo detiene nuevas solicitudes, pero no elimina registros recibidos por el operador ni letras ya guardadas localmente. Estas siguen sujetas a los controles habituales de borrado y almacenamiento de la biblioteca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定で LRCLIB を有効・無効にできます。無効化すると新たな要求を停止しますが、運営者が受信済みのログや保存済みの歌詞は削除されません。歌詞には通常のライブラリ削除・ストレージ操作が適用されます。"
          }
        }
      }
    },
    "policy.lrclib.025": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The user can withdraw Provider consent at any time from the LRCLIB Provider detail page. Withdrawal also disables the Provider. The local player and locally stored media remain usable without accepting this disclosure or enabling LRCLIB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户可随时在 LRCLIB 服务详情页撤回同意，服务也会同时关闭。即使不接受本说明或不启用 LRCLIB，本地播放器和本地媒体仍可使用。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le consentement peut être retiré à tout moment sur la page du fournisseur LRCLIB, ce qui le désactive également. Le lecteur local et les médias locaux restent utilisables sans accepter ces informations ni activer LRCLIB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zustimmung kann jederzeit auf der LRCLIB-Anbieterseite widerrufen werden; dadurch wird der Anbieter ebenfalls deaktiviert. Lokaler Player und lokale Medien bleiben ohne Zustimmung zu diesen Hinweisen und ohne LRCLIB nutzbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes retirar el consentimiento en cualquier momento desde el detalle del proveedor LRCLIB; esto también lo desactiva. El reproductor y los archivos locales siguen disponibles sin aceptar este aviso ni activar LRCLIB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LRCLIB の詳細ページからいつでも同意を撤回でき、同時に機能も無効になります。本説明に同意せず LRCLIB を有効にしなくても、ローカルプレーヤーとメディアは利用できます。"
          }
        }
      }
    },
    "policy.lrclib.026": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "变更"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifications"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambios"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更"
          }
        }
      }
    },
    "policy.lrclib.027": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the app changes the information sent to LRCLIB or the purpose of the integration, this disclosure will be updated before the changed behavior is released. The version and effective date above will also be updated, and the app may request consent again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若应用改变发送给 LRCLIB 的信息或集成用途，会在新行为发布前更新本说明、版本和生效日期，并可能再次请求同意。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si les données envoyées ou la finalité changent, ces informations seront mises à jour avant la publication du nouveau comportement. La version et la date seront actualisées et un nouveau consentement pourra être demandé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändern sich die gesendeten Informationen oder der Integrationszweck, werden diese Hinweise vor Veröffentlichung des neuen Verhaltens aktualisiert. Version und Datum werden angepasst; die App kann erneut um Zustimmung bitten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cambian la información enviada o la finalidad, este aviso se actualizará antes de publicar el nuevo comportamiento. También se actualizarán la versión y la fecha, y la app podría solicitar de nuevo tu consentimiento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信情報や利用目的が変わる場合は、変更のリリース前に本説明を更新します。バージョンと発効日も更新し、再度同意を求める場合があります。"
          }
        }
      }
    },
    "policy.lrclib.028": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "联系"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontakt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お問い合わせ"
          }
        }
      }
    },
    "policy.lrclib.029": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For questions about how MyMusic: Local Player integrates LRCLIB, open an issue in the public <a href=\"https://github.com/enefry/MusicFree/issues\">MusicFree GitHub Issues</a>. Please do not include passwords, private keys, or other sensitive personal information in a public issue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如有 MyMusic: Local Player 集成 LRCLIB 的问题，请在公开的 <a href=\"https://github.com/enefry/MusicFree/issues\">MusicFree GitHub Issues</a> 中提交。请勿在公开问题中包含密码、私钥或其他敏感个人信息。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour toute question sur l’intégration LRCLIB, ouvrez un ticket public dans <a href=\"https://github.com/enefry/MusicFree/issues\">MusicFree GitHub Issues</a>. N’y incluez aucun mot de passe, clé privée ni autre donnée personnelle sensible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Fragen zur LRCLIB-Integration eröffnen Sie ein öffentliches Issue unter <a href=\"https://github.com/enefry/MusicFree/issues\">MusicFree GitHub Issues</a>. Fügen Sie keine Passwörter, privaten Schlüssel oder anderen sensiblen persönlichen Daten hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tienes preguntas sobre la integración de LRCLIB, abre una incidencia pública en <a href=\"https://github.com/enefry/MusicFree/issues\">MusicFree GitHub Issues</a>. No incluyas contraseñas, claves privadas ni otros datos personales sensibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LRCLIB 連携についての質問は公開の <a href=\"https://github.com/enefry/MusicFree/issues\">MusicFree GitHub Issues</a> へお寄せください。パスワード、秘密鍵、機密の個人情報を公開の問題報告に含めないでください。"
          }
        }
      }
    },
