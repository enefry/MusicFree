    "将从资料库和 App 托管存储中删除“%@”；Documents 中的原始文件不会被删除。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” will be removed from the library and app-managed storage; the original file in Documents will not be deleted."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将从资料库和 App 托管存储中删除“%@”；Documents 中的原始文件不会被删除。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » sera supprimé de la bibliothèque et du stockage géré par l’app ; le fichier d’origine dans Documents ne sera pas supprimé."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird aus der Mediathek und dem von der App verwalteten Speicher entfernt; die Originaldatei in Documents wird nicht gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” se eliminará de la biblioteca y del almacenamiento gestionado por la app; el archivo original de Documents no se eliminará."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
