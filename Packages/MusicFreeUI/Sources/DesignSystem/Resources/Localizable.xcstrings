    "操作只处理应用生成的缓存或已记录的维护事务，不会删除资料库媒体文件。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This only handles app-generated caches or recorded maintenance transactions. Library media files will not be deleted."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
