    "guide.drive.036": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open <a href=\"https://console.cloud.google.com/\" target=\"_blank\" rel=\"noreferrer\">Google Cloud Console</a> and sign in with the account that will manage OAuth."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 <a href=\"https://console.cloud.google.com/\" target=\"_blank\" rel=\"noreferrer\">Google Cloud 控制台</a>，使用管理 OAuth 的账户登录。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez <a href=\"https://console.cloud.google.com/\" target=\"_blank\" rel=\"noreferrer\">Google Cloud Console</a> et connectez-vous avec le compte qui gérera OAuth."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie die <a href=\"https://console.cloud.google.com/\" target=\"_blank\" rel=\"noreferrer\">Google Cloud Console</a> und melden Sie sich mit dem OAuth-Verwaltungskonto an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre <a href=\"https://console.cloud.google.com/\" target=\"_blank\" rel=\"noreferrer\">Google Cloud Console</a> e inicia sesión con la cuenta que gestionará OAuth."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<a href=\"https://console.cloud.google.com/\" target=\"_blank\" rel=\"noreferrer\">Google Cloud Console</a> を開き、OAuth を管理するアカウントでログインします。"
          }
        }
      }
    },
    "guide.drive.037": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the project selector at the top, then choose an existing project or create a new one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击顶部项目选择器，选择已有项目或新建一个。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le sélecteur de projet en haut, puis choisissez un projet existant ou créez-en un."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oben die Projektauswahl öffnen und ein vorhandenes Projekt auswählen oder ein neues erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa el selector de proyecto de arriba y elige uno existente o crea uno nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上部のプロジェクト選択から既存のものを選ぶか、新規作成します。"
          }
        }
      }
    },
    "guide.drive.038": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can name it <b>MusicFree Drive</b>. Keep this project selected for every remaining step."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可命名为 <b>MusicFree Drive</b>。后续步骤请始终选中此项目。"
