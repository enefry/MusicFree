            "value": "The Client ID identifies the app; the reversed ID routes back to it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "客户端 ID 用于标识应用；反向 ID 用于返回应用。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ID client identifie l’app ; l’ID inversé permet d’y revenir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Client-ID identifiziert die App; die umgekehrte ID führt zu ihr zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ID de cliente identifica la app; el ID inverso permite volver a ella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クライアント ID はアプリを識別し、逆順 ID はアプリへの戻り先を指定します。"
