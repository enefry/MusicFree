    "元数据查询发送歌曲名称和艺人；歌词查询可能附带专辑和时长。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Metadata searches send the song title and artist; lyrics searches may also include the album and duration." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "元数据查询发送歌曲名称和艺人；歌词查询可能附带专辑和时长。" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les recherches de métadonnées envoient le titre et l’artiste ; les recherches de paroles peuvent aussi inclure l’album et la durée." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Metadatensuchen senden Titel und Interpret; bei Liedtextsuchen können zusätzlich Album und Dauer übertragen werden." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Las búsquedas de metadatos envían el título y el artista; las búsquedas de letras también pueden incluir el álbum y la duración." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "メタデータ検索では曲名とアーティストを送信します。歌詞検索ではアルバムと再生時間が含まれる場合があります。" } }
      }
    },
    "关闭 Provider 后不再发送新的请求；已经由第三方服务接收的请求日志由其隐私政策管理。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "After a Provider is disabled, no new requests are sent; request logs already received by the third party are governed by its privacy policy." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭 Provider 后不再发送新的请求；已经由第三方服务接收的请求日志由其隐私政策管理。" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Après la désactivation d’un Provider, aucune nouvelle requête n’est envoyée ; les journaux déjà reçus par le service tiers sont régis par sa politique de confidentialité." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Nach der Deaktivierung eines Providers werden keine neuen Anfragen gesendet; bereits vom Drittanbieter empfangene Anfragelogs unterliegen dessen Datenschutzrichtlinie." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Después de desactivar un Provider, no se envían nuevas solicitudes; los registros de solicitudes que ya haya recibido el tercero se rigen por su política de privacidad." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Providerを無効にすると新しいリクエストは送信されません。第三者サービスがすでに受け取ったリクエストログは、そのプライバシーポリシーに従って扱われます。" } }
      }
    },
    "发送信息" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Information sent" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "发送信息" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Informations envoyées" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Gesendete Informationen" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Información enviada" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "送信される情報" } }
      }
    },
    "同意后，应用才会在你开启 Provider 时向对应服务发送歌曲匹配信息。应用不会主动上传音频文件、完整文件路径或整个音乐库。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "After consent, the app sends song matching information to a service only when you enable its Provider. The app does not intentionally upload audio files, complete file paths, or the full music library." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "同意后，应用才会在你开启 Provider 时向对应服务发送歌曲匹配信息。应用不会主动上传音频文件、完整文件路径或整个音乐库。" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Après votre consentement, l’app envoie des informations de correspondance des chansons au service uniquement lorsque vous activez son Provider. L’app ne téléverse pas intentionnellement de fichiers audio, de chemins complets ni l’intégralité de la bibliothèque musicale." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Nach Ihrer Zustimmung sendet die App nur dann Informationen zum Songabgleich an einen Dienst, wenn Sie dessen Provider aktivieren. Die App lädt weder Audiodateien noch vollständige Dateipfade oder die gesamte Musikmediathek absichtlich hoch." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Tras dar tu consentimiento, la app envía información para hacer coincidir canciones al servicio solo cuando activas su Provider. La app no sube intencionadamente archivos de audio, rutas completas ni toda la biblioteca musical." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "同意すると、アプリはProviderを有効にしたときだけ、曲の照合情報を対応するサービスに送信します。音声ファイル、完全なファイルパス、音楽ライブラリ全体をアプリが意図的にアップロードすることはありません。" } }
      }
    },
