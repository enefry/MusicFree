    "guide.drive.066": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Publishing status set to <b>Testing</b>."
          }
        },
        "zh-Hans": {
