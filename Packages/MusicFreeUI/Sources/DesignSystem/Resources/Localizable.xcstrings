        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez le nommer <b>MusicFree Drive</b>. Gardez ce projet sélectionné pour toutes les étapes suivantes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können es <b>MusicFree Drive</b> nennen. Dieses Projekt für alle weiteren Schritte ausgewählt lassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes llamarlo <b>MusicFree Drive</b>. Mantén este proyecto seleccionado en los pasos siguientes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前は <b>MusicFree Drive</b> などにします。以降もこのプロジェクトを選択したままにします。"
          }
        }
      }
    },
