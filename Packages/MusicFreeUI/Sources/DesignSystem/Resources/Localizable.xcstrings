    "The library persistence store is corrupted." : {"extractionState":"manual","comment":"App-owned error reason; translated at the presentation boundary.","localizations":{"en":{"stringUnit":{"state":"translated","value":"The library persistence store is corrupted."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"资料库存储已损坏。"}},"de":{"stringUnit":{"state":"translated","value":"Der dauerhafte Mediathekspeicher ist beschädigt."}},"es":{"stringUnit":{"state":"translated","value":"El almacenamiento persistente de la biblioteca está dañado."}},"fr":{"stringUnit":{"state":"translated","value":"Le stockage persistant de la bibliothèque est corrompu."}},"ja":{"stringUnit":{"state":"translated","value":"ライブラリの永続ストレージが破損しています。"}}}},
    "The library persistence store contains an invalid record." : {"extractionState":"manual","comment":"App-owned error reason; translated at the presentation boundary.","localizations":{"en":{"stringUnit":{"state":"translated","value":"The library persistence store contains an invalid record."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"资料库存储包含无效记录。"}},"de":{"stringUnit":{"state":"translated","value":"Der dauerhafte Mediathekspeicher enthält einen ungültigen Eintrag."}},"es":{"stringUnit":{"state":"translated","value":"El almacenamiento persistente de la biblioteca contiene un registro no válido."}},"fr":{"stringUnit":{"state":"translated","value":"Le stockage persistant de la bibliothèque contient une entrée invalide."}},"ja":{"stringUnit":{"state":"translated","value":"ライブラリの永続ストレージに無効なレコードがあります。"}}}},
    "A library value could not be encoded for persistence." : {"extractionState":"manual","comment":"App-owned error reason; translated at the presentation boundary.","localizations":{"en":{"stringUnit":{"state":"translated","value":"A library value could not be encoded for persistence."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法编码资料库数据以进行存储。"}},"de":{"stringUnit":{"state":"translated","value":"Ein Mediathekwert konnte nicht für die Speicherung codiert werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo codificar un valor de la biblioteca para guardarlo."}},"fr":{"stringUnit":{"state":"translated","value":"Impossible d’encoder une valeur de la bibliothèque pour le stockage."}},"ja":{"stringUnit":{"state":"translated","value":"ライブラリの値を保存用にエンコードできませんでした。"}}}},
    "The library persistence store is closed." : {"extractionState":"manual","comment":"App-owned error reason; translated at the presentation boundary.","localizations":{"en":{"stringUnit":{"state":"translated","value":"The library persistence store is closed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"资料库存储已关闭。"}},"de":{"stringUnit":{"state":"translated","value":"Der dauerhafte Mediathekspeicher ist geschlossen."}},"es":{"stringUnit":{"state":"translated","value":"El almacenamiento persistente de la biblioteca está cerrado."}},"fr":{"stringUnit":{"state":"translated","value":"Le stockage persistant de la bibliothèque est fermé."}},"ja":{"stringUnit":{"state":"translated","value":"ライブラリの永続ストレージが閉じています。"}}}},
    "The Synology account requires a one-time verification code." : {"extractionState":"manual","comment":"App-owned error reason; translated at the presentation boundary.","localizations":{"en":{"stringUnit":{"state":"translated","value":"The Synology account requires a one-time verification code."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"群晖账号需要一次性验证码。"}},"de":{"stringUnit":{"state":"translated","value":"Das Synology-Konto benötigt einen einmaligen Bestätigungscode."}},"es":{"stringUnit":{"state":"translated","value":"La cuenta de Synology requiere un código de verificación de un solo uso."}},"fr":{"stringUnit":{"state":"translated","value":"Le compte Synology nécessite un code de vérification à usage unique."}},"ja":{"stringUnit":{"state":"translated","value":"Synologyアカウントにはワンタイム認証コードが必要です。"}}}},
    "正在验证" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Verifying"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在验证"}},"de":{"stringUnit":{"state":"translated","value":"Überprüfung läuft"}},"es":{"stringUnit":{"state":"translated","value":"Verificando"}},"fr":{"stringUnit":{"state":"translated","value":"Vérification en cours"}},"ja":{"stringUnit":{"state":"translated","value":"検証中"}}}},
    "取消收藏专辑" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove Album from Favorites"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"取消收藏专辑"}},"de":{"stringUnit":{"state":"translated","value":"Album aus Favoriten entfernen"}},"es":{"stringUnit":{"state":"translated","value":"Quitar álbum de favoritos"}},"fr":{"stringUnit":{"state":"translated","value":"Retirer l’album des favoris"}},"ja":{"stringUnit":{"state":"translated","value":"アルバムをお気に入りから削除"}}}},
    "收藏专辑" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Favorite Album"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"收藏专辑"}},"de":{"stringUnit":{"state":"translated","value":"Album zu Favoriten hinzufügen"}},"es":{"stringUnit":{"state":"translated","value":"Añadir álbum a favoritos"}},"fr":{"stringUnit":{"state":"translated","value":"Ajouter l’album aux favoris"}},"ja":{"stringUnit":{"state":"translated","value":"アルバムをお気に入りに追加"}}}},
    "更多选项" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"More Options"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"更多选项"}},"de":{"stringUnit":{"state":"translated","value":"Weitere Optionen"}},"es":{"stringUnit":{"state":"translated","value":"Más opciones"}},"fr":{"stringUnit":{"state":"translated","value":"Plus d’options"}},"ja":{"stringUnit":{"state":"translated","value":"その他のオプション"}}}},
    "收藏的歌曲和专辑会显示在这里。" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your favorite songs and albums appear here."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"收藏的歌曲和专辑会显示在这里。"}},"de":{"stringUnit":{"state":"translated","value":"Deine Lieblingstitel und -alben werden hier angezeigt."}},"es":{"stringUnit":{"state":"translated","value":"Tus canciones y álbumes favoritos aparecen aquí."}},"fr":{"stringUnit":{"state":"translated","value":"Vos morceaux et albums favoris s’affichent ici."}},"ja":{"stringUnit":{"state":"translated","value":"お気に入りの曲とアルバムがここに表示されます。"}}}},
    "无法播放" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to Play"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法播放"}},"de":{"stringUnit":{"state":"translated","value":"Wiedergabe nicht möglich"}},"es":{"stringUnit":{"state":"translated","value":"No se puede reproducir"}},"fr":{"stringUnit":{"state":"translated","value":"Lecture impossible"}},"ja":{"stringUnit":{"state":"translated","value":"再生できません"}}}},
    "网络抓包 (DEBUG)" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Network Capture (DEBUG)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"网络抓包 (DEBUG)"}},"de":{"stringUnit":{"state":"translated","value":"Netzwerkaufzeichnung (DEBUG)"}},"es":{"stringUnit":{"state":"translated","value":"Captura de red (DEBUG)"}},"fr":{"stringUnit":{"state":"translated","value":"Capture réseau (DEBUG)"}},"ja":{"stringUnit":{"state":"translated","value":"ネットワークキャプチャ（DEBUG）"}}}},
    "网络请求" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Network Requests"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"网络请求"}},"de":{"stringUnit":{"state":"translated","value":"Netzwerkanfragen"}},"es":{"stringUnit":{"state":"translated","value":"Solicitudes de red"}},"fr":{"stringUnit":{"state":"translated","value":"Requêtes réseau"}},"ja":{"stringUnit":{"state":"translated","value":"ネットワークリクエスト"}}}},
    "查看网络请求" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"View Network Requests"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查看网络请求"}},"de":{"stringUnit":{"state":"translated","value":"Netzwerkanfragen anzeigen"}},"es":{"stringUnit":{"state":"translated","value":"Ver solicitudes de red"}},"fr":{"stringUnit":{"state":"translated","value":"Voir les requêtes réseau"}},"ja":{"stringUnit":{"state":"translated","value":"ネットワークリクエストを表示"}}}},
    "抓包已开启。关闭后需重启 App 才会停止本次运行中的抓包。请求数据仅保存在本机。" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Capture is enabled. After disabling it, restart the app to stop capture for this session. Request data is stored only on this device."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"抓包已开启。关闭后需重启 App 才会停止本次运行中的抓包。请求数据仅保存在本机。"}},"de":{"stringUnit":{"state":"translated","value":"Die Aufzeichnung ist aktiviert. Nach dem Deaktivieren muss die App neu gestartet werden, um die Aufzeichnung dieser Sitzung zu beenden. Anfragedaten werden nur auf diesem Gerät gespeichert."}},"es":{"stringUnit":{"state":"translated","value":"La captura está activada. Después de desactivarla, reinicia la app para detener la captura de esta sesión. Los datos de las solicitudes solo se guardan en este dispositivo."}},"fr":{"stringUnit":{"state":"translated","value":"La capture est activée. Après l’avoir désactivée, redémarrez l’app pour arrêter la capture de cette session. Les données des requêtes sont stockées uniquement sur cet appareil."}},"ja":{"stringUnit":{"state":"translated","value":"キャプチャは有効です。無効にした後、このセッションのキャプチャを停止するにはAppを再起動してください。リクエストデータはこのデバイスにのみ保存されます。"}}}},
    "开启后记录 URLSession 网络请求；默认关闭，仅 Debug 构建可用。" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Records URLSession network requests when enabled. Off by default and available only in Debug builds."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"开启后记录 URLSession 网络请求；默认关闭，仅 Debug 构建可用。"}},"de":{"stringUnit":{"state":"translated","value":"Zeichnet URLSession-Netzwerkanfragen auf, wenn aktiviert. Standardmäßig deaktiviert und nur in Debug-Builds verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"Registra las solicitudes de red de URLSession al activarse. Desactivado por defecto y disponible solo en compilaciones Debug."}},"fr":{"stringUnit":{"state":"translated","value":"Enregistre les requêtes réseau URLSession lorsque la capture est activée. Désactivée par défaut et disponible uniquement dans les versions Debug."}},"ja":{"stringUnit":{"state":"translated","value":"有効にするとURLSessionのネットワークリクエストを記録します。デフォルトでは無効で、Debugビルドでのみ利用できます。"}}}},
    "The shared Documents directory could not be scanned." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The shared Documents directory could not be scanned."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法扫描共享 Documents 目录。"}},"de":{"stringUnit":{"state":"translated","value":"Der freigegebene Documents-Ordner konnte nicht durchsucht werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo explorar la carpeta Documents compartida."}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de parcourir le dossier Documents partagé."}},"ja":{"stringUnit":{"state":"translated","value":"共有のDocumentsフォルダをスキャンできませんでした。"}}}},
    "The Documents import ended without a result." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The Documents import ended without a result."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Documents 导入结束，但未返回结果。"}},"de":{"stringUnit":{"state":"translated","value":"Der Documents-Import wurde ohne Ergebnis beendet."}},"es":{"stringUnit":{"state":"translated","value":"La importación de Documents terminó sin un resultado."}},"fr":{"stringUnit":{"state":"translated","value":"L’importation de Documents s’est terminée sans résultat."}},"ja":{"stringUnit":{"state":"translated","value":"Documentsの読み込みが結果を返さずに終了しました。"}}}},
    "前台按设置并发转码；后台仅在音乐播放中运行一个转码任务，暂停、停止或缓冲时会暂停并保留进度，继续播放后自动恢复。" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"In the foreground, conversions use your concurrency setting. In the background, one conversion runs while music is playing; pausing, stopping, or buffering pauses conversion with progress preserved, and conversion resumes when playback continues."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"前台按设置并发转码；后台仅在音乐播放中运行一个转码任务，暂停、停止或缓冲时会暂停并保留进度，继续播放后自动恢复。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"前景依設定並行轉碼；背景僅在音樂播放中執行一個轉碼任務，暫停、停止或緩衝時會暫停並保留進度，繼續播放後自動恢復。"}},"de":{"stringUnit":{"state":"translated","value":"Im Vordergrund gilt die eingestellte Anzahl gleichzeitiger Konvertierungen. Im Hintergrund läuft eine Konvertierung während der Musikwiedergabe. Beim Pausieren, Stoppen oder Puffern wird sie angehalten und der Fortschritt gespeichert; sie wird mit der Wiedergabe fortgesetzt."}},"es":{"stringUnit":{"state":"translated","value":"En primer plano se usa el número de conversiones simultáneas configurado. En segundo plano se ejecuta una conversión mientras se reproduce música; al pausar, detener o almacenar en búfer, se pausa conservando el progreso y se reanuda al continuar la reproducción."}},"fr":{"stringUnit":{"state":"translated","value":"Au premier plan, le nombre de conversions simultanées suit votre réglage. En arrière-plan, une seule conversion s’exécute pendant la lecture de musique ; une pause, un arrêt ou une mise en mémoire tampon la suspend en conservant sa progression. Elle reprend avec la lecture."}},"ja":{"stringUnit":{"state":"translated","value":"フォアグラウンドでは設定した数の変換を同時に実行します。バックグラウンドでは音楽の再生中に1件の変換を実行し、一時停止、停止、バッファリング中は進捗を保持して変換を一時停止します。再生を続けると自動的に再開します。"}}}},
    "转为简体" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Convert to Simplified"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"转为简体"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"轉為簡體"}},"de":{"stringUnit":{"state":"translated","value":"In vereinfachtes Chinesisch umwandeln"}},"es":{"stringUnit":{"state":"translated","value":"Convertir a chino simplificado"}},"fr":{"stringUnit":{"state":"translated","value":"Convertir en chinois simplifié"}},"ja":{"stringUnit":{"state":"translated","value":"簡体字に変換"}}}},
    "转为繁体" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Convert to Traditional"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"转为繁体"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"轉為繁體"}},"de":{"stringUnit":{"state":"translated","value":"In traditionelles Chinesisch umwandeln"}},"es":{"stringUnit":{"state":"translated","value":"Convertir a chino tradicional"}},"fr":{"stringUnit":{"state":"translated","value":"Convertir en chinois traditionnel"}},"ja":{"stringUnit":{"state":"translated","value":"繁体字に変換"}}}},
    "无可转换的歌词" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"No lyrics to convert"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无可转换的歌词"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"沒有可轉換的歌詞"}},"de":{"stringUnit":{"state":"translated","value":"Keine Liedtexte zum Umwandeln"}},"es":{"stringUnit":{"state":"translated","value":"No hay letras para convertir"}},"fr":{"stringUnit":{"state":"translated","value":"Aucune parole à convertir"}},"ja":{"stringUnit":{"state":"translated","value":"変換できる歌詞がありません"}}}},
    "歌词转换失败，请重试。" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not convert lyrics. Try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"歌词转换失败，请重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"歌詞轉換失敗，請重試。"}},"de":{"stringUnit":{"state":"translated","value":"Die Liedtexte konnten nicht umgewandelt werden. Bitte erneut versuchen."}},"es":{"stringUnit":{"state":"translated","value":"No se pudieron convertir las letras. Inténtalo de nuevo."}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de convertir les paroles. Réessayez."}},"ja":{"stringUnit":{"state":"translated","value":"歌詞を変換できませんでした。もう一度お試しください。"}}}},
    "这会覆盖当前保存的歌词，反向转换不一定能恢复原文。" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This replaces the saved lyrics. Converting back may not restore the original text."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这会覆盖当前保存的歌词，反向转换不一定能恢复原文。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"這會覆蓋目前儲存的歌詞，反向轉換不一定能還原原文。"}},"de":{"stringUnit":{"state":"translated","value":"Die gespeicherten Liedtexte werden ersetzt. Eine Rückumwandlung stellt den ursprünglichen Text möglicherweise nicht wieder her."}},"es":{"stringUnit":{"state":"translated","value":"Esto reemplaza las letras guardadas. La conversión inversa puede no restaurar el texto original."}},"fr":{"stringUnit":{"state":"translated","value":"Les paroles enregistrées seront remplacées. Une conversion inverse ne rétablira pas forcément le texte original."}},"ja":{"stringUnit":{"state":"translated","value":"保存されている歌詞を上書きします。逆変換しても元のテキストに戻らない場合があります。"}}}},
    "音频转换" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Audio Conversion"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"音频转换"}},"de":{"stringUnit":{"state":"translated","value":"Audiokonvertierung"}},"es":{"stringUnit":{"state":"translated","value":"Conversión de audio"}},"fr":{"stringUnit":{"state":"translated","value":"Conversion audio"}},"ja":{"stringUnit":{"state":"translated","value":"音声変換"}}}},
