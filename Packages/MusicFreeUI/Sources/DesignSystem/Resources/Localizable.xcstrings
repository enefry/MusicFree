    },
    "插件声明的来源目录与临时媒体访问数据。凭据只保存在系统 Keychain。" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source catalogs and temporary media access data declared by the plugin. Credentials are stored only in the system Keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插件声明的来源目录与临时媒体访问数据。凭据只保存在系统 Keychain。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Catalogues de sources et données d’accès temporaire aux médias déclarés par le plugin. Les identifiants restent dans le trousseau système."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom Plugin angegebene Quellenkataloge und temporäre Medienzugriffsdaten. Zugangsdaten bleiben im Systemschlüsselbund."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Catálogos de fuentes y datos temporales de acceso multimedia declarados por el complemento. Las credenciales se guardan solo en el llavero del sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プラグインが宣言したソースのディレクトリと一時的なメディアアクセスデータです。認証情報はシステムのキーチェーンにのみ保存されます。"
          }
        }
      }
    },
